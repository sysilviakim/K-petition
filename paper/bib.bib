@article{kantorowicz-reznichenko_dont_2022,
	title = {Don't believe it! {A} global perspective on cognitive reflection and conspiracy theories about {COVID}-19 pandemic},
	volume = {194},
	issn = {0191-8869},
	url = {https://www.sciencedirect.com/science/article/pii/S0191886922001702},
	doi = {10.1016/j.paid.2022.111666},
	abstract = {The COVID-19 pandemic increased the saliency of an old phenomenon – conspiracy theories. In times of a global crisis and an unprecedented access to information, fake news seems to spread as fast as the virus. A global pandemic requires more than ever self-compliance. Only behavior change and vaccination on a large scale can bring us to normality. Yet believing in conspiracy theories about COVID-19 is expected to undermine such compliance. What determines susceptibility to believing in misinformation? In this study, using data on mostly representative samples of 45 countries around the world (38,113 participants), we found evidence that people with more deliberate thinking are less likely to believe in conspiracy theories. Furthermore, on the individual level people who are more prone to believe in conspiracy theories are less likely to comply with behavior change. We are in the midst of the biggest coordination game and such insights in social psychology can inform policymakers.},
	urldate = {2025-07-22},
	journal = {Personality and Individual Differences},
	author = {Kantorowicz-Reznichenko, Elena and Folmer, Chris Reinders and Kantorowicz, Jaroslaw},
	month = aug,
	year = {2022},
	keywords = {Analytical thinking, COVID-19 pandemic, Compliance, Conspiracy theories},
	pages = {111666},
}

@article{uscinski_who_nodate,
	title = {Who believes {Trump} conspired with {Russia} to steal the 2016 election? {Evidence} from a survey experiment},
	volume = {0},
	issn = {1745-7289},
	shorttitle = {Who believes {Trump} conspired with {Russia} to steal the 2016 election?},
	url = {https://doi.org/10.1080/17457289.2025.2514197},
	doi = {10.1080/17457289.2025.2514197},
	abstract = {Russia’s interference and the Trump campaign’s contacts with Russian agents led to speculation about a conspiracy between Donald Trump and Russia to rig the 2016 election. While the Mueller investigation uncovered numerous illegal activities, it fell short of concluding that the Trump campaign had conspired with Russia to rig the election. However, many Americans believed, both prior to, and after, the release of the Mueller Report that Trump conspired with Russia. To better understand these beliefs, we embedded an experiment within a national survey. Subjects were assigned randomly to one of three cues alleging that the Trump campaign’s contacts with Russia were “part of a conspiracy,” “the result of poor judgment,” or “standard campaign operating procedure.” These subtle cues did not affect beliefs about the existence of Russian interference or about Trump’s involvement in it. Instead, Democrats/liberals, those critical of Trump, and those with higher levels of conspiracy thinking were more likely to believe that Russia interfered and that the Trump campaign conspired with Russia. Trump supporters on the other hand were likely to deny that Russia interfered in the election. Our findings shed light on the factors driving public views towards this unique episode in American history.},
	number = {0},
	urldate = {2025-07-22},
	journal = {Journal of Elections, Public Opinion and Parties},
	author = {Uscinski, Joseph and Littrell, Shane and Klofstad, Casey A.},
	note = {Publisher: Routledge
\_eprint: https://doi.org/10.1080/17457289.2025.2514197},
	keywords = {2016 election, Russia, Trump, conspiracy, experiment, survey},
	pages = {1--20},
}

@article{enders_modeling_2023,
	title = {On modeling the correlates of conspiracy thinking},
	volume = {13},
	copyright = {2023 The Author(s)},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-023-34391-6},
	doi = {10.1038/s41598-023-34391-6},
	abstract = {While a robust literature on the psychology of conspiracy theories has identified dozens of characteristics correlated with conspiracy theory beliefs, much less attention has been paid to understanding the generalized predisposition towards interpreting events and circumstances as the product of supposed conspiracies. Using a unique national survey of 2015 U.S. adults from October 2020, we investigate the relationship between this predisposition—conspiracy thinking—and 34 different psychological, political, and social correlates. Using  conditional inference tree modeling—a machine learning-based approach designed to facilitate prediction using a flexible modeling methodology—we identify the characteristics that are most useful for orienting individuals along the conspiracy thinking continuum, including (but not limited to): anomie, Manicheanism, support for political violence, a tendency to share false information online, populism, narcissism, and psychopathy. Altogether, psychological characteristics are much more useful in predicting conspiracy thinking than are political and social characteristics, though even our robust set of correlates only partially accounts for variance in conspiracy thinking.},
	language = {en},
	number = {1},
	urldate = {2025-07-22},
	journal = {Scientific Reports},
	author = {Enders, Adam M. and Diekman, Amanda and Klofstad, Casey and Murthi, Manohar and Verdear, Daniel and Wuchty, Stefan and Uscinski, Joseph},
	month = may,
	year = {2023},
	note = {Publisher: Nature Publishing Group},
	keywords = {Human behaviour, Psychology and behaviour},
	pages = {8325},
}

@article{enders_sociodemographic_2024,
	title = {The sociodemographic correlates of conspiracism},
	volume = {14},
	copyright = {2024 The Author(s)},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-024-64098-1},
	doi = {10.1038/s41598-024-64098-1},
	abstract = {Despite hundreds of studies examining belief in conspiracy theories, it is still unclear who—demographically—is most likely to believe such theories. To remedy this knowledge gap, we examine survey data containing various operationalizations of conspiracism across diverse sociopolitical contexts. Study 1 employs a 2021 U.S. survey (n = 2021) to examine associations between sociodemographic characteristics and beliefs in 39 conspiracy theories. Study 2 similarly employs a survey of 20 countries (n = 26,416) and 11 conspiracy theory beliefs. Study 3 reports results from a 2020 U.S. survey (n = 2015) measuring perceptions about which groups are engaging in conspiracies. Study 4 interrogates data from nine U.S. surveys (2012–2022; n = 14,334) to examine the relationships between sociodemographic characteristics and generalized conspiracy thinking. Study 5 synchronizes studies 1–4 to provide an intersectional analysis of conspiracy theory belief. Across studies, we observe remarkably consistent patterns: education, income, age (older), and White identification are negatively related to conspiracism, while Black identification is positively related. We conclude by discussing why conspiracy theories may appeal most to historically marginalized groups and how our findings can inform efforts to mitigate the negative effects of conspiracy theories.},
	language = {en},
	number = {1},
	urldate = {2025-07-22},
	journal = {Scientific Reports},
	author = {Enders, Adam and Klofstad, Casey and Diekman, Amanda and Drochon, Hugo and Rogers de Waal, Joel and Littrell, Shane and Premaratne, Kamal and Verdear, Daniel and Wuchty, Stefan and Uscinski, Joseph},
	month = jun,
	year = {2024},
	note = {Publisher: Nature Publishing Group},
	keywords = {Human behaviour, Psychology},
	pages = {14184},
}

