	author = {Gross, Donald August and Goidel, Robert K.},
	year = {2003},
	keywords = {Political Science / American Government / General, Political Science / Political Process / Campaigns \& Elections, Political Science / Public Policy / Economic Policy, Political Science / Public Policy / General},
