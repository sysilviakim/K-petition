@incollection{green_thirty_2004,
	address = {Boston, MA},
	series = {International {Series} in {Quantitative} {Marketing}},
	title = {Thirty {Years} of {Conjoint} {Analysis}: {Reflections} and {Prospects}},
	isbn = {978-0-387-28692-1},
	shorttitle = {Thirty {Years} of {Conjoint} {Analysis}},
	url = {https://doi.org/10.1007/978-0-387-28692-1_6},
