@article{fouirnaies_how_2021,
	title = {How {Do} {Campaign} {Spending} {Limits} {Affect} {Elections}? {Evidence} from the {United} {Kingdom} 1885–2019},
	volume = {115},
	issn = {0003-0554, 1537-5943},
	shorttitle = {How {Do} {Campaign} {Spending} {Limits} {Affect} {Elections}?},
	url = {https://www.cambridge.org/core/product/identifier/S0003055420001008/type/journal_article},
	doi = {10.1017/S0003055420001008},
	abstract = {In more than half of the democratic countries in the world, candidates face legal constraints on how much money they can spend on their electoral campaigns, yet we know little about the consequences of these restrictions. I study how spending limits affect UK House of Commons elections. I contribute new data on the more than 70,000 candidates who ran for a parliamentary seat from 1885 to 2019, and I document how much money each candidate spent, how they allocated their resources across different spending categories, and the spending limit they faced. To identify the effect on elections, I exploit variation in spending caps induced by reforms of the spending-limit formula that affected some but not all constituencies. The results indicate that when the level of permitted spending is increased, the cost of electoral campaigns increases, which is primarily driven by expenses related to advertisement and mainly to the disadvantage of Labour candidates; the pool of candidates shrinks and elections become less competitive; and the financial and electoral advantages enjoyed by incumbents are amplified.},
	number = {2},
	urldate = {2022-12-30},
	journal = {American Political Science Review},
	author = {Fouirnaies, Alexander},
	year = {2021},
	pages = {395--411},
}

@article{bhavnani_local_2018,
	title = {Local {Embeddedness} and {Bureaucratic} {Performance}: {Evidence} from {India}},
	volume = {80},
	issn = {0022-3816},
	shorttitle = {Local {Embeddedness} and {Bureaucratic} {Performance}},
	url = {https://www.journals.uchicago.edu/doi/abs/10.1086/694101},
	doi = {10.1086/694101},
	abstract = {While locally embedded bureaucrats may be more willing and able to enhance public goods provisioning in the places that they serve, they may also be more likely to be captured by elite interests. We reconcile these two viewpoints by arguing that locally embedded bureaucrats enhance public goods provisioning when they can be held accountable by the public. We test this theory using data from India, examining how changes in public goods provision within districts are related to the embeddedness of the senior bureaucrats who served in them, using the plausibly random initial assignment of bureaucrats to account for the endogeneity of officer assignment. We find that officers from the state they serve increase public goods provision. Consistent with our theory, this effect is only present in districts with conditions that favor accountability. Our findings further the literatures on embeddedness, bureaucracy, leadership, and development.},
	number = {1},
	urldate = {2022-12-30},
	journal = {The Journal of Politics},
	author = {Bhavnani, Rikhil R. and Lee, Alexander},
	year = {2018},
	pages = {71--87},
}

