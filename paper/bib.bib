	keywords = {Political Science / Comparative Politics, Political Science / General, Political Science / History \& Theory, Political Science / Political Ideologies / Democracy, Political Science / Political Process / Campaigns \& Elections, Political Science / Political Process / General, Political Science / Political Process / Political Advocacy},
