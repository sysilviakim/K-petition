	url = {http://www.proquest.com/docview/236998125/abstract/19FC1BEE4E304758PQ/1},
	abstract = {The rapid growth of campaign spending after 1960 (Dollar Politics, 1982, p. 9) brought campaign finance practices under intense congressional and scholarly scrutiny. Congressional scrutiny culminated in new regulatory legislation, the Federal Election Campaign Act (FECA) of 1971. The form of regulaiion adopted--full disclosure of contributions and expenditures and limits on contributions but not spending--created an unprecedented opportunity for scholarly investigation. It produced the first tolerably accurate accounting of money raised and spent in campaigns for...},
