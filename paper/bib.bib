@article{luskin_measuring_1987,
	title = {Measuring {Political} {Sophistication}},
	volume = {31},
	issn = {0092-5853},
	url = {https://www.jstor.org/stable/2111227},
	doi = {10.2307/2111227},
	abstract = {The vast, discordant literature on political sophistication, still divided over the variable's distribution in mass publics, is correspondingly divided over measurement. This paper, focusing on measurement, weighs the merits in these disputes. I first review the variable we all claim to be measuring, then the measures the literature affords. In the process I sketch several measures of my own and compare their empirical performance. Then, finally, I examine the distributional implications and offer some thoughts on future directions for sophistication research.},
