@article{cann_justice_2007,
	title = {Justice for {Sale}? {Campaign} {Contributions} and {Judicial} {Decisionmaking}},
	volume = {7},
	issn = {1532-4400, 1946-1607},
	shorttitle = {Justice for {Sale}?},
	url = {http://www.cambridge.org/core/journals/state-politics-and-policy-quarterly/article/abs/justice-for-sale-campaign-contributions-and-judicial-decisionmaking/26519DA259FBEBC62D53DA5987857ACA},
	doi = {10.1177/153244000700700303},
	abstract = {As state judicial campaigns become progressively more expensive and political, judicial candidates have turned more frequently to lawyers and law firms for campaign contributions. Given that lawyers who contribute to judges' campaigns frequently appear before them in court, the potential for a conflict of interest arises. I ask whether judges are more likely to rule in favor of attorneys who provide financial support to their campaigns. Looking at cases decided in the Supreme Court of Georgia's 2003 term, I show that campaign contributions are indeed correlated with judges' decisions. Furthermore, I use a two-stage probit least squares estimator to show that these campaign contributions directly affect judicial decisionmaking.},
	number = {3},
	urldate = {2022-06-24},
	journal = {State Politics \& Policy Quarterly},
	author = {Cann, Damon M.},
	year = {2007},
	pages = {281--297},
}

@book{grenzke_money_1990,
	title = {Money and {Congressional} {Behavior}},
	isbn = {978-0-429-04422-9},
	url = {http://www.taylorfrancis.com/chapters/edit/10.4324/9780429044229-10/money-congressional-behavior-janet-grenzke},
	abstract = {Political equality, because Political action committees (PAC) money reflects and reinforces the unequal distribution of wealth in America that translates into unequal political power. Successful studies of whether PAC money influences votes must control for the influence of the legislator’s constituency, ideology, party, the President, and interest group activity beyond contributions, on members’ roll-call votes. In fact, scholars have begun to turn their attention to some specific areas where PAC money might be expected to be significant. The coincidence of congressional roll-call votes and PAC contributions is used as evidence that money buys member votes. Focusing primarily on roll-call votes may keep scholars preoccupied with studying this behavior because of its ease of measurement while overlooking other important but less easily observable arenas of influence, such as the committee and subcommittee level. PAC money may be a more important factor in structuring decisions before they reach the level of roll-call votes or in preventing matters from ever being seriously considered.},
	urldate = {2022-06-24},
	publisher = {Routledge},
	author = {Grenzke, Janet},
	year = {1990},
}

