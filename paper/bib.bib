	editor = {Pickel, Susanne and Pickel, Gert and Lauth, Hans-Joachim and Jahn, Detlef},
	year = {2009},
	doi = {10.1007/978-3-531-91826-6_25},
	pages = {497--516},
}

@article{ilieva_online_2002,
	title = {Online {Surveys} in {Marketing} {Research}},
	volume = {44},
	issn = {1470-7853},
	url = {https://doi.org/10.1177/147078530204400303},
	doi = {10.1177/147078530204400303},
	abstract = {In a recent article on conducting international marketing research in the twenty-first century (Craig \& Douglas 2001), the application of new (electronic) technology for data collection was encouraged. Email and web-based data collection methods are attractive to researchers in international marketing because of low costs and fast response rates. Yet the conventional wisdom is that, as some people still do not have access to e-mail and the Internet, such data-collection techniques may often result in a sample of respondents that is not representative of the desired population. In this article we evaluate multimode strategies of data collection that include web-based, e-mail and postal methods as a means for the international marketing researcher to obtain survey data from a representative sample. An example is given of a multimode strategy applied to the collection of survey data from a sample of respondents across 100 countries.},
	number = {3},
	urldate = {2023-02-20},
	journal = {International Journal of Market Research},
	author = {Ilieva, Janet and Baron, Steve and Healey, Nigel M.},
	year = {2002},
	pages = {1--14},
}

@article{blair_statistical_2012,
	title = {Statistical {Analysis} of {List} {Experiments}},
	volume = {20},
	issn = {1047-1987, 1476-4989},
	url = {https://www.cambridge.org/core/journals/political-analysis/article/statistical-analysis-of-list-experiments/6AEE6C9D3AB6DA410D602CB035D5959A},
	doi = {10.1093/pan/mpr048},
	abstract = {The validity of empirical research often relies upon the accuracy of self-reported behavior and beliefs. Yet eliciting truthful answers in surveys is challenging, especially when studying sensitive issues such as racial prejudice, corruption, and support for militant groups. List experiments have attracted much attention recently as a potential solution to this measurement problem. Many researchers, however, have used a simple difference-in-means estimator, which prevents the efficient examination of multivariate relationships between respondents' characteristics and their responses to sensitive items. Moreover, no systematic means exists to investigate the role of underlying assumptions. We fill these gaps by developing a set of new statistical methods for list experiments. We identify the commonly invoked assumptions, propose new multivariate regression estimators, and develop methods to detect and adjust for potential violations of key assumptions. For empirical illustration, we analyze list experiments concerning racial prejudice. Open-source software is made available to implement the proposed methodology.},
	language = {en},
	number = {1},
	urldate = {2023-02-20},
	journal = {Political Analysis},
	author = {Blair, Graeme and Imai, Kosuke},
	year = {2012},
	note = {Publisher: Cambridge University Press},
	pages = {47--77},
}

@article{aronow_combining_2015,
	title = {Combining {List} {Experiment} and {Direct} {Question} {Estimates} of {Sensitive} {Behavior} {Prevalence}},
	volume = {3},
	issn = {2325-0984},
	url = {https://doi.org/10.1093/jssam/smu023},
	doi = {10.1093/jssam/smu023},
	abstract = {Survey respondents may give untruthful answers to sensitive questions when asked directly. In recent years, researchers have turned to the list experiment (also known as the item count technique) to overcome this difficulty. While list experiments are arguably less prone to bias than direct questioning, list experiments are also more susceptible to sampling variability. We show that researchers need not abandon direct questioning altogether in order to gain the advantages of list experimentation. We develop a nonparametric estimator of the prevalence of sensitive behaviors that combines list experimentation and direct questioning. We prove that this estimator is asymptotically more efficient than the standard difference-in-means estimator, and we provide a basis for inference using Wald-type confidence intervals. Additionally, leveraging information from the direct questioning, we derive two nonparametric placebo tests for assessing identifying assumptions underlying list experiments. We demonstrate the effectiveness of our combined estimator and placebo tests with an original survey experiment.},
	number = {1},
	urldate = {2023-02-20},
	journal = {Journal of Survey Statistics and Methodology},
	author = {Aronow, Peter m. and Coppock, Alexander and Crawford, Forrest W. and Green, Donald P.},
	month = mar,
	year = {2015},
	pages = {43--66},
}

@article{glynn_what_2013,
	title = {What {Can} {We} {Learn} with {Statistical} {Truth} {Serum}?: {Design} and {Analysis} of the {List} {Experiment}},
	volume = {77},
	issn = {0033-362X},
	shorttitle = {What {Can} {We} {Learn} with {Statistical} {Truth} {Serum}?},
	url = {https://doi.org/10.1093/poq/nfs070},
	doi = {10.1093/poq/nfs070},
	abstract = {Due to the inherent sensitivity of many survey questions, a number of researchers have adopted an indirect questioning technique known as the list experiment (or the item-count technique) in order to reduce dishonest or evasive responses. However, standard practice with the list experiment requires a large sample size, utilizes only a difference-in-means estimator, and does not provide a measure of the sensitive item for each respondent. This paper addresses all of these issues. First, the paper presents design principles for the standard list experiment (and the double list experiment) for the reduction of bias and variance as well as providing sample-size formulas for the planning of studies. Second, this paper proves that a respondent-level probabilistic measure for the sensitive item can be derived. This provides a basis for diagnostics, improved estimation, and regression analysis. The techniques in this paper are illustrated with a list experiment from the 2008–2009 American National Election Studies (ANES) Panel Study and an adaptation of this experiment.},
	number = {S1},
	urldate = {2023-02-20},
	journal = {Public Opinion Quarterly},
	author = {Glynn, Adam N.},
	month = jan,
	year = {2013},
	pages = {159--172},
}

@article{kuklinski_racial_1997,
	title = {Racial {Attitudes} and the "{New} {South}"},
	volume = {59},
	issn = {0022-3816},
	url = {https://www.journals.uchicago.edu/doi/abs/10.1017/S0022381600053470},
	doi = {10.1017/S0022381600053470},
	abstract = {An abundance of survey research conducted over the past two decades has portrayed a "new South" in which the region's white residents now resemble the remainder of the country in their racial attitudes No longer is the South the bastion of racial prejudice. Using a new and relatively unobtrusive measure of racial attitudes designed to overcome possible social desirability effects, our study finds racial prejudice to be still high in the South and markedly higher in the South than the non-South. Preliminary evidence also indicates that this prejudice is concentrated among white southern men Comparison of these results with responses to traditional survey questions suggests that social desirability contaminates the latter. This finding helps to explain why the "new South" thesis has gained currency.},
	number = {2},
	urldate = {2023-02-20},
	journal = {The Journal of Politics},
	author = {Kuklinski, James H. and Cobb, Michael D. and Gilens, Martin},
	year = {1997},
	pages = {323--349},
}

@article{__2001,
	title = {미국 ‘거버넌스({Governance}) 위기론’의 대외정책적 함의와 그 평가},
	volume = {35},
	issn = {1229-506X},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE00764974},
	abstract = {오늘날 미국 대외정책 결정과정상 의회의 점증하는 적극성과 그에 따른 의회-행정부 갈등을 거버넌스 위기의 관점에서 보는 사람이 많다. 즉 미국 정치의 근원적 거버넌스 문제의 결과이자 한 원인으로 의회가 대외정책과 관련해서 발언권을 높이고 행정부와 대립 및 교착 관계에 빠지고 있다는 것이다. 그러나 이 논문은 그러한 거버넌스 위기론의 관점이 타당성을 결여하고 있음을 밝힌다. 첫째, 미국 의회의 목소리가 과거에 비해서는 커졌지만, 대외정책 주도권은 여전히 대통령이 쥐고 있다. 둘째, 의원들이 대외정책 토론과정에서는 왕성하게 의사를 개진하고 극단적ㆍ비타협적 발언도 하지만 최종 정책 결정시에는 행정부 요구나 당 지도부 입장에 따라가는 수사(修辭)적 행태를 보이는 경향이 있다. 이 점은 의원들의 정치적 적극성이 미국 대외정책을 장기간의 교착상태에 빠뜨리기 어렵다는 것을 보여준다. 셋째, 의회의 도전적 태도와 의외-대통령 갈등은 오히려 미국의 대외 협상력을 결과적으로 높일 수도 있다. 넷째, 의회와 대통령 간에 민주적 견제와 균형이 도모될 때 미국 대외정책의 정통성이 대내외적으로 강화되고 정책의 안정성이 기해질 수 있고 정책결과에 대한 책임 분산을 통해 대내외 비난의 예봉을 비껴 나가며 정치적 타격을 막을 수도 있다. 역동적 정치 대립이 단기적으로 잡음을 자아낼 수 있지만, 장기적으로 오히려 미국 국익을 촉진할 수 있다. 이러한 이유들을 볼 때, 미국 대외정책 결정과정상의 의회-행정부 갈등을 거버넌스 위기론의 각도에서 부정적으로 평가하기는 곤란하다.},
	language = {ko},
	number = {1},
	urldate = {2023-02-19},
	journal = {한국정치학회보},
	author = {임성호},
	month = jun,
	year = {2001},
	keywords = {거버넌스 위기, 대외협상력, 미국 대외정책 결정과정, 의회-행정부 갈등, 의회의 적극성},
	pages = {287--305},
}

@article{__2007,
	title = {지역학의 일부인가 정치학의 핵심인가: 미국정치연구의 성격과 과제},
	volume = {30},
	shorttitle = {지역학의 일부인가 정치학의 핵심인가},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE08996483},
	abstract = {【Abstract】 A Part of Area Studies or a Core of Political Science?: Methodological Note for Studies of American Politics Seong-Ho Lim (Kyung Hee University) This article provides a methodological perspective to guide studies of American politics. Main argument goes that studies of American politics should go beyond area studies to become a core of comparative politics. Full integration into the field of comparative politics would require a balance between contextual specificity and theoretical generality. A close observation of concrete details of specific cases in American politics must be complemented by a theoretical effort to find broad implications for comparative politics in general. A theory-conscious Americanist would take a theory-driven, not data-driven, approach and would view American politics as an important, but not exclusive, case to be theoretically compared with politics in other parts of the world. He or she would also understand that a theoretical effort calls for intellectual interactions with political scientists in various fields; in the words of King, Keohane, and Verba, studies of American politics ought to be a “social enterprise.” This article discusses in detail in what sense and how a researcher on American politics could elevate one’s work to a core of comparative politics and, more generally, political science. This article also warns of some methodological problems hampering this theoretical elevation, and presents a sample of specific topics in American politics promising to avoid them.},
	language = {ko},
	urldate = {2023-02-19},
	journal = {미국학},
	author = {임성호},
	year = {2007},
	keywords = {area studies, comparative politics, contextual specificity, methodology, studies of American politics, theoretical generality, 맥락적 구체성, 미국정치연구, 방법론, 비교정치학, 이론적 일반성, 지역학},
	pages = {149--177},
}

@article{__2007-1,
	title = {국가정체성의 강화와 정당 양극화: 미국정치의 패러독스?},
	volume = {23},
	shorttitle = {국가정체성의 강화와 정당 양극화},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE08997009},
	abstract = {과연 국가정체성과 정치 양극화는 상호 모순적 역비례 관계에 있다는 가정이 옳을까? 이 글은 일견 타당해 보이고 널리 받아들여지는 이 가정이 이론적으로나 경험적으로 설득력이 없다는 점을 밝힌다. 이를 위해 Ⅱ절에서는 국가정체성과 정당성향(정파심)이 상호 충돌하기보다 오히려 상호 강화하는 관계라는 점을 이론적 차원에서 논한다. Ⅲ절에서는 미국 정치사를 살펴보며 미국인들의 국가정체성이 강했던 시기에 오히려 정당간 대결이 양극적으로 격렬했고 근래 들어서도 국가정체성의 강화와 공화당 대 민주당의 양극화 심화가 같이 진행되고 있음을 서술한다. Ⅳ절에서는 여론조사 결과에 대한 분석을 통해, 미국인의 마음속에서 국가정체성과 정당성향이 명확한 정비례 상관관계를 지닌다는 점을 확인한다. 강한 국가정체성과 강한 정당성향의 공존은 불가사의한 패러독스가 아니라는 이 글의 주장은, 정치 양극화와 국가정체성에 관한 미국학계의 논쟁이 좀더 새로운 연구 지평을 찾아 나가야 한다는 시사점을 던진다.},
	language = {ko},
	number = {1},
	urldate = {2023-02-19},
	journal = {한국과 국제정치},
	author = {임성호},
	year = {2007},
	keywords = {American politics, National identity, Partisanship, Party identification, Party polarization, 국가정체성, 미국정치, 정당 양극화, 정당성향, 정파심},
	pages = {1--32},
}

@article{__2015,
	title = {연방제도 다양성과 통일한국 연방제도의 함의},
	volume = {24},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE10880678},
	abstract = {본 논문은 복수의 정부단계 간 중앙집중화와 탈중앙화의 압력을 자신에게 유리한 균형점으로 이끌어내려는 끊임없는 탐색전 결과물인 연방제도의 다양성에 관한 일고로부터 통일한국 연방제도의 함의를 도출하고자 한다. 정부조직형태로서 연방제도는 대내외적으로 위기에 대처할 수 있는 강력한 중앙정부와 국민에게 근접한 거주지에서 작동하는 기능적 지역-지방정부의 장점을 극대화하는 것을 목표로 한다. 이는 중앙과 비중앙을 국가라는 단일한 인위적 정치 공동체로 통합하면서도 비중앙의 등가성을 보장하는 다층 거버넌스를 요구한다. 따라서 연방주의가 중앙과 비중앙 간 공치(共治)와 자치(自治)의 균형점에 대한 공감대가 형성되는 경우, 연방제도는 ‘공유 연방주권(shared federative sovereignty)’을 구현할 수 있다. 그렇다면 통치원칙으로서 연방주의가 구현된 연방제도에 보편적으로 성립되는 공치(共治)와 자치(自治) 간 균형점은 어떠한 형태로 나타나는가? 또한 헌법 상 연방주의를 통치 원칙으로 정립한 연방국가는 수직적 권한 분산을 어떠한 방식으로 구현하는가? 더불어 연방제도의 다양성에 관한 일고를 통해 얻을 수있는 통일한국의 연방제도에 대한 함의는 무엇인가? 본 논문에서는 이에 순차적으로 답함으로써 연방제도화(federalization)의 조작적 정의를 도출하는 후속연구에 대한 초보 작업을 수행하고자 한다.},
	language = {ko},
	number = {1},
	urldate = {2023-02-19},
	journal = {한국정치연구},
	author = {이옥연},
	year = {2015},
	keywords = {federal system, multi-level division of power, self-rule, shared federative sovereignty, shared rule, 공유 연방주권, 공치(共治), 수직적 권한분산, 연방제도, 자치(自治)},
	pages = {55--82},
}

