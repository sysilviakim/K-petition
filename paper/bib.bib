@article{atkeson_new_2010,
	title = {A new barrier to participation: {Heterogeneous} application of voter identification policies},
	volume = {29},
	issn = {0261-3794},
	shorttitle = {A new barrier to participation},
	url = {http://www.sciencedirect.com/science/article/pii/S0261379409000912},
	doi = {10.1016/j.electstud.2009.08.001},
	abstract = {In democratic societies there is a tension between maximizing ballot access and minimizing voter fraud. Since the 2000 presidential election, this tension has been central to discussions about election reform at the national, state, and local level. We examine this tension by focusing on the implementation of voter identification laws in one state that has experienced significant issues in recent elections, and that is currently implementing election reform: New Mexico. We hypothesize that Hispanic voters are more likely to show some form of identification than other types of voters. Using a voter data set from New Mexico's First Congressional District in the 2006 election, we find that Hispanic, male and Election Day voters are more likely to show some form of identification than non-Hispanic, female and early voters. In addition, using an overlapping study of Bernalillo County 2006 poll workers, which almost entirely overlaps with the First Congressional District, we find no evidence that differences in poll worker partisanship or ethnicity produce differences in voter identification procedures. Our findings suggest that broad voter identification laws, which may be applied unequally, may be perceived as discriminatory.},
	language = {en},
	number = {1},
	urldate = {2020-08-05},
	journal = {Electoral Studies},
	author = {Atkeson, Lonna Rae and Bryant, Lisa Ann and Hall, Thad E. and Saunders, Kyle and Alvarez, Michael},
	year = {2010},
	keywords = {Bureaucracy, Discrimination, Elections, Latinos/Hispanic, Political behavior, Poll worker, Public opinion, Public policy, Voter identification, Voting},
	pages = {66--73},
}

@article{kropf_making_2020,
	title = {Making {Every} {Vote} {Count}: {The} {Important} {Role} of {Managerial} {Capacity} in {Achieving} {Better} {Election} {Administration} {Outcomes}},
	volume = {80},
	issn = {1540-6210},
	shorttitle = {Making {Every} {Vote} {Count}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/puar.13216},
	doi = {https://doi.org/10.1111/puar.13216},
	abstract = {A public agency's capacity to implement policy and achieve valued public outcomes has been a long-running area of research in public administration. Many articles provide theory and empirics regarding the capacity to implement policy, but relatively few examine multiple types of agency capacity within the same analysis. This article develops a model based on the election administration literature in political science and public administration to examine the effects of managerial capacity, financial capacity, and technology on the election management outcome of the residual vote rate in North Carolina election jurisdictions. The results indicate that higher levels of management capacity and technology significantly reduce problems with voting as measured by the residual vote rate. Financial capacity shows a negative association with the residual vote rate but is not significant. The article concludes by discussing how studying election administration provides an important and uniquely good administrative context for developing administrative theory.},
	language = {en},
	number = {5},
	urldate = {2021-08-08},
	journal = {Public Administration Review},
	author = {Kropf, Martha and Pope, JoEllen V. and Shepherd, Mary Jo and Mohr, Zachary},
	year = {2020},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/puar.13216},
	pages = {733--742},
}

