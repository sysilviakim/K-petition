@article{breuning_promise_2005,
	title = {Promise and {Performance}: {An} {Evaluation} of {Journals} in {International} {Relations}},
	volume = {6},
	issn = {1528-3577},
	shorttitle = {Promise and {Performance}},
	url = {https://doi.org/10.1111/j.1528-3577.2005.00220.x},
	doi = {10.1111/j.1528-3577.2005.00220.x},
	abstract = {What kind of international relations research gets published in the field’s most recognized journals? Who are its authors? This study investigates the subject matter, methodology, and origin of recent research published in top international relations journals, building on earlier work that has investigated the contents of journals. This study investigates the contents of three international relations journals—International Studies Quarterly, International Organization, and World Politics— which have been consistently ranked as the top three journals in international relations. Data are for the ten most recent completed volume years, 1995–2004. This study finds that international relations scholarship in these three journals focuses on a relatively narrow range of subjects and is produced by a rather homogeneous group of scholars.},
	number = {4},
	urldate = {2023-02-10},
	journal = {International Studies Perspectives},
	author = {Breuning, Marijke and Bredehoft, Joseph and Walton, Eugene},
	month = nov,
	year = {2005},
	pages = {447--461},
}

@article{breuning_clearing_2018,
	title = {Clearing the {Pipeline}? {Gender} and the {Review} {Process} at the {American} {Political} {Science} {Review}},
	volume = {51},
	issn = {1049-0965, 1537-5935},
	shorttitle = {Clearing the {Pipeline}?},
	url = {https://www.cambridge.org/core/journals/ps-political-science-and-politics/article/clearing-the-pipeline-gender-and-the-review-process-at-the-american-political-science-review/57F7DB799F8154AB7D5541717E689631},
	doi = {10.1017/S1049096518000069},
	abstract = {Is the peer-review process at academic journals gendered? The answer to this question has important implications for the advancement of women in the political science profession. However, few studies have had access to data that can evaluate whether the peer-review process is gendered. We investigate this for papers submitted to the American Political Science Review across two editorial teams to identify trends over time. We evaluate overall differences across gender, but we also present more fine-grained data to evaluate gender differences across subfield, methodology, and submitting author’s institutional affiliation and academic rank. Furthermore, we show that prior service as a reviewer is associated with a higher acceptance rate for first-time submitters. We demonstrate that the review process is not gendered. Women’s share of submissions and acceptances has risen but remains lower than their presence in the discipline.},
	language = {en},
	number = {3},
	urldate = {2023-02-10},
	journal = {PS: Political Science \& Politics},
	author = {Breuning, Marijke and Gross, Benjamin Isaak and Feinberg, Ayal and Martinez, Melissa and Sharma, Ramesh and Ishiyama, John},
	month = jul,
	year = {2018},
	note = {Publisher: Cambridge University Press},
	pages = {629--634},
}

@article{beltran_apsa_2005,
	title = {{APSA} {Task} {Force} on {Graduate} {Education}: 2004 {Report} to the {Council}},
	volume = {38},
	issn = {1537-5935, 1049-0965},
	shorttitle = {{APSA} {Task} {Force} on {Graduate} {Education}},
	url = {https://www.cambridge.org/core/journals/ps-political-science-and-politics/article/apsa-task-force-on-graduate-education-2004-report-to-the-council/BC40C4DEDA34E5A81A7C3975E382D117},
	doi = {10.1017/S1049096505056258},
	abstract = {In spring 2002, APSA President-Elect Theda Skocpol appointed this Task Force on Graduate
        Education, representing a variety of institutions, political science subfields, scholarly
        backgrounds, and methodological viewpoints. She asked its members to report on ways to
        strengthen graduate education in political science. The Task Force quickly concluded that no
        single structure of graduate training could be appropriate for the wide range of
        institutions offering graduate instruction in political science, and that departments must
        decide for themselves what programs best suited their capacities and interests.},
	number = {1},
	urldate = {2023-02-10},
