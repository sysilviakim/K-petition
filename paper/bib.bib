}

@article{shineman_if_2018,
	title = {If {You} {Mobilize} {Them}, {They} {Will} {Become} {Informed}: {Experimental} {Evidence} that {Information} {Acquisition} {Is} {Endogenous} to {Costs} and {Incentives} to {Participate}},
	volume = {48},
	issn = {0007-1234, 1469-2112},
	shorttitle = {If {You} {Mobilize} {Them}, {They} {Will} {Become} {Informed}},
	url = {http://www.cambridge.org/core/journals/british-journal-of-political-science/article/if-you-mobilize-them-they-will-become-informed-experimental-evidence-that-information-acquisition-is-endogenous-to-costs-and-incentives-to-participate/F61335132F8DE29D105E213C0AA512D8},
	doi = {10.1017/S0007123416000168},
	abstract = {Because non-voters are less politically informed than voters, some propose that increasing voter turnout would reduce the quality of information among the active voting population, damaging electoral outcomes. However, the proposed tradeoff between increased participation and informed participation is a false dichotomy. This article demonstrates that political information is endogenous to participation. A field experiment integrates an intensive mobilization treatment into a panel survey conducted before and after a city-wide election. Subjects who were mobilized to vote also became more informed about the content of the election. The results suggest institutions that encourage participation not only increase voter turnout – mobilizing electoral participation also motivates citizens to become more politically informed.},
	language = {en},
	number = {1},
	urldate = {2021-08-09},
	journal = {British Journal of Political Science},
	author = {Shineman, Victoria Anne},
	month = jan,
	year = {2018},
	note = {Publisher: Cambridge University Press},
	keywords = {compulsory voting, field experiment, mandatory voting., mobilization, political sophistication, voter turnout},
	pages = {189--211},
}

