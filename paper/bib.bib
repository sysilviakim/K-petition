	volume = {44},
	issn = {1537-5935, 1049-0965},
	url = {https://www.cambridge.org/core/journals/ps-political-science-and-politics/article/navigating-the-academic-job-market-in-treacherous-times/9F5133A793CF8164E950771EE9813041},
