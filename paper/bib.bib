@article{li_chronos_2012,
	title = {Chronos: facilitating history discovery by linking temporal records},
	volume = {5},
	issn = {2150-8097},
	shorttitle = {Chronos},
	url = {https://dl.acm.org/doi/10.14778/2367502.2367559},
	doi = {10.14778/2367502.2367559},
	abstract = {Many data sets contain temporal records over a long period of time; each record is associated with a time stamp and describes some aspects of a realworld entity at that particular time. From such data, users often wish to search for entities in a particular period and understand the history of one entity or all entities in the data set. A major challenge for enabling such search and exploration is to identify records that describe the same realworld entity over a long period of time; however, linking temporal records is hard given that the values that describe an entity can evolve over time (e.g., a person can move from one afﬁliation to another).},
