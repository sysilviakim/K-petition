	issn = {1537-5935, 1049-0965},
	shorttitle = {Network in {Progress}},
	url = {https://www.cambridge.org/core/journals/ps-political-science-and-politics/article/network-in-progress-a-conference-primer-for-graduate-students/562AEF7C0BB6C4559CE8626C1678A1FC},
