@article{shino_john_2021,
	title = {John {B}. {Holbein} and {D}. {Sunshine} {Hillygus}. {Making} {Young} {Voters}: {Converting} {Civic} {Attitudes} into {Civic} {Action}},
	volume = {85},
	issn = {0033-362X},
	shorttitle = {John {B}. {Holbein} and {D}. {Sunshine} {Hillygus}. {Making} {Young} {Voters}},
	url = {https://doi.org/10.1093/poq/nfab016},
	doi = {10.1093/poq/nfab016},
	abstract = {In Making Young Voters, Holbein and Hillygus revisit one of the foundational questions in the political participation literature: Why do so many politically motivated young people fail to participate in elections? Differing from previous literature, Holbein and Hillygus argue that political motivation is a necessary but not sufficient condition to stimulate participation. They challenge the widely used theory that young voters do not vote because they lack political motivation; instead, they argue that “noncognitive skills are a missing piece of the turnout puzzle” (p. 2). Their book is divided into two parts. The first part establishes that noncognitive skills matter and they are understudied in political science. The second part offers policy recommendations on how to “raise” and “train” young voters to participate in elections through the education system and electoral reforms.},
	number = {2},
	urldate = {2023-01-22},
	journal = {Public Opinion Quarterly},
	author = {Shino, Enrijeta},
	year = {2021},
	pages = {725--727},
}

@article{baldwin_economic_2010,
	title = {Economic versus {Cultural} {Differences}: {Forms} of {Ethnic} {Diversity} and {Public} {Goods} {Provision}},
	volume = {104},
	issn = {1537-5943, 0003-0554},
	shorttitle = {Economic versus {Cultural} {Differences}},
	url = {https://www.cambridge.org/core/journals/american-political-science-review/article/economic-versus-cultural-differences-forms-of-ethnic-diversity-and-public-goods-provision/1A668817F0A20FE9FF613B2247654A0E},
	doi = {10.1017/S0003055410000419},
	abstract = {Arguments about how ethnic diversity affects governance typically posit that groups differ from each other in substantively important ways and that these differences make effective governance more difficult. But existing cross-national empirical tests typically use measures of ethnolinguistic fractionalization (ELF) that have no information about substantive differences between groups. This article examines two important ways that groups differ from each other—culturally and economically—and assesses how such differences affect public goods provision. Across 46 countries, the analysis compares existing measures of cultural differences with a new measure that captures economic differences between groups: between-group inequality (BGI). We show that ELF, cultural fractionalization (CF), and BGI measure different things, and that the choice between them has an important impact on our understanding of which countries are most ethnically diverse. Furthermore, empirical tests reveal that BGI has a large, robust, and negative relationship with public goods provision, whereas CF, ELF, and overall inequality do not.},
	number = {4},
	urldate = {2023-01-20},
	journal = {American Political Science Review},
	author = {Baldwin, Kate and Huber, John D.},
	year = {2010},
	pages = {644--662},
}

@article{grillo_reference_2023,
	title = {Reference {Points} and {Democratic} {Backsliding}},
	volume = {67},
	issn = {1540-5907},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12672},
	doi = {10.1111/ajps.12672},
	abstract = {We propose a theory of democratic backsliding where citizens' retrospective assessment of an incumbent politician depends on expectations that are endogenous to the incumbent's behaviour. We show that democratic backsliding can occur even when most citizens and most politicians intrinsically value democracy. By challenging norms of democracy, an incumbent can lower citizens' expectations; by not doubling down on this challenge, he can then beat this lowered standard. As a result, gradual backsliding can actually enhance an incumbent's popular support not despite but because of citizens' opposition to backsliding. This mechanism can only arise when citizens are uncertain enough about incumbents' preferences (e.g. owing to programmatically weak parties). Mass polarization, instead, can reduce the occurrence of backsliding while simultaneously increasing its severity.},
	number = {1},
	urldate = {2021-11-05},
	journal = {American Journal of Political Science},
	author = {Grillo, Edoardo and Prato, Carlo},
	year = {2023},
	pages = {71--88},
}

@article{crespin_serving_2010,
	title = {Serving {Two} {Masters}: {Redistricting} and {Voting} in the {U}.{S}. {House} of {Representatives}},
	volume = {63},
	issn = {1065-9129},
	shorttitle = {Serving {Two} {Masters}},
	url = {https://doi.org/10.1177/1065912909338465},
	doi = {10.1177/1065912909338465},
	abstract = {This article explores the consequences for representation after a redistricting by reexamining the finding that members of Congress will alter their voting behavior to fit their new district. Specifically, it applies partisan theories of congressional organization to test if members are changing their behavior on all or just some votes. The results indicate that representatives adjust their roll call behavior to fit their new districts on votes that are visible to their constituents. However, when it comes to votes that are important to the party for controlling the agenda (i.e., procedural votes), members do not respond to changes in the district.},
	language = {en},
	number = {4},
	urldate = {2023-01-20},
	journal = {Political Research Quarterly},
	author = {Crespin, Michael H.},
	month = dec,
	year = {2010},
	note = {Publisher: SAGE Publications Inc},
	pages = {850--859},
}

@article{crespin_using_2005,
	title = {Using {Geographic} {Information} {Systems} to {Measure} {District} {Change}, 2000–2002},
	volume = {13},
	issn = {1047-1987, 1476-4989},
	url = {https://www.cambridge.org/core/journals/political-analysis/article/abs/using-geographic-information-systems-to-measure-district-change-20002002/7DD4C09029080154DC4CD7479C958426},
