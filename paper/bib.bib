@article{song_effect_2020,
	title = {The effect of public financing on candidate reemergence and success in elections},
	volume = {65},
	issn = {0176-2680},
	url = {https://www.sciencedirect.com/science/article/pii/S0176268020300677},
	doi = {10.1016/j.ejpoleco.2020.101919},
	abstract = {In this paper, I estimate the causal effect of public funding of elections on candidates' reemergence and success using a regression discontinuity design in the context of South Korean municipal legislative elections. I find that public financing has no overall effect on candidate reemergence and success in a subsequent election. I do find, however, that campaign expense reimbursement has a positive effect on those who are formerly underrepresented in politics, especially women, in whose case it increases the probability of running again by 24.6 percentage points and that of winning the next election by 10.1 percentage points. I also find some suggestive evidence that campaign expense reimbursement can help female candidates become career politicians.},
	urldate = {2022-11-27},
	journal = {European Journal of Political Economy},
	author = {Song, B. K.},
	year = {2020},
	keywords = {Campaign finance, Elections, Regression discontinuity, Representation, Women in politics},
	pages = {101919},
}

@article{avis_money_2022,
	title = {Money and {Politics}: {The} {Effects} of {Campaign} {Spending} {Limits} on {Political} {Entry} and {Competition}},
	volume = {14},
	issn = {1945-7782},
	shorttitle = {Money and {Politics}},
	url = {http://www.aeaweb.org/articles?id=10.1257/app.20200296},
	doi = {10.1257/app.20200296},
	abstract = {This paper studies the effects of campaign spending limits on the political entry, selection, and behavior of local politicians in Brazil. We analyze a reform that limits campaign spending for mayoral elections. The limits were implemented with a discontinuity that we exploit for causal identification. We find that stricter limits reduce reelection rates and increase political competition by attracting more candidates who are also less wealthy and rely less on self-financing. Despite their effects on electoral outcomes, stricter limits did not lead to significant short-run improvements in policy outcomes, such as in education and health.},
	number = {4},
	urldate = {2022-11-25},
	journal = {American Economic Journal: Applied Economics},
	author = {Avis, Eric and Ferraz, Claudio and Finan, Frederico and Varjão, Carlos},
	year = {2022},
	keywords = {Institutional Arrangements, Political Processes: Rent-seeking, Lobbying, Elections, Legislatures, and Voting Behavior, Formal and Informal Sectors, Shadow Economy},
	pages = {167--199},
}

@article{milligan_campaign_2008,
	title = {Campaign spending limits, incumbent spending, and election outcomes},
	volume = {41},
	issn = {1540-5982},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1540-5982.2008.00507.x},
	doi = {10.1111/j.1540-5982.2008.00507.x},
	abstract = {Abstract. We study the impact of campaign spending limits for candidates in Canadian federal elections. We first demonstrate that spending limits are binding mostly for incumbent candidates. We then use this information to produce endogeneity-corrected estimates for the impact of incumbent spending on electoral vote shares. Furthermore, we examine the impact of spending limits on broader measures of electoral outcomes, finding that larger limits lead to less close elections, fewer candidates, and lower voter turnout.},
	number = {4},
	urldate = {2022-11-25},
	journal = {Canadian Journal of Economics/Revue canadienne d'économique},
	author = {Milligan, Kevin and Rekkas, Marie},
	year = {2008},
	pages = {1351--1374},
}

@misc{kettler_season_2014,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {The {Season} for {Giving}: {Candidate} {Contributions} and the {Path} to {Leadership}},
	shorttitle = {The {Season} for {Giving}},
	url = {https://papers.ssrn.com/abstract=2454648},
	abstract = {Can we identify future party leaders? We know legislators are more likely to become party leaders when they contribute extensively to other candidates and party committees (Currinder 2009; Heberlig and Larson 2012; Powell 2012). However, we know little about how legislators allocate their funds in an effort to increase their probability of becoming a leader. I argue that it is not just giving money to other candidates that matter when seeking leadership positions. Instead, whom an actor is connected to through their donations may matter more than the amount of contributions. The allocation strategies of party actors may impact their ability to successfully obtain leadership positions or passing desired policies after the election. In this study, I examine whether candidates translate positions of influence in the party network into leadership positions. By using campaign contributions in the 2012 election for six states to map out the party network, I measure the influence of candidates within the party. I find that influential candidates in political party networks are more likely to become legislative leaders than other, less-connected candidates.},
	urldate = {2022-11-04},
	author = {Kettler, Jaclyn},
	year = {2014},
	keywords = {campaign finance, campaigns \& elections, political parties, subnational politics},
}

