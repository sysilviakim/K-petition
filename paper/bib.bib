	volume = {46},
	issn = {1049-0965, 1537-5935},
	shorttitle = {Communicating in 140 {Characters} or {Less}},
	url = {https://www.cambridge.org/core/journals/ps-political-science-and-politics/article/communicating-in-140-characters-or-less-congressional-adoption-of-twitter-in-the-111th-congress/6D65BAB70C1D58D133B70C14F3AEF628},
