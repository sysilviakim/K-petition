	pages = {41--46},
}

@article{nahm_petition_topicmodeling_2022,
	title = {전자청원 플랫폼의 도전과 기회: 청와대 국민청원 제시 글의 토픽모델링},
	volume = {18},
	issn = {1598-1029},
	shorttitle = {전자청원 플랫폼의 도전과 기회},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE11276356},
	abstract = {사회의 규모와 복잡성이 증대되는 만큼 새로운 정보기술을 결합한 정부의 정책 및 제도가 공공영역 에서 시행하고 있다. 플랫폼은 정보기술을 적용한 비즈니스 모델로 미래 사회의 새로운 가치를 창출 하고 효과적인 행정서비스를 제공하기 위해 기여한다. 우리나라는 사회적 변화에 빠르게 대응하기 위 해 플랫폼 형태의 전자청원을 도입함으로써 사회적 문제 및 이슈에 효과적으로 대응하고 있다. 전자 청원 도입 이후 사회적 문제가 어떻게 발생하였는지를 살펴보고 해결 방안을 모색하기 위해 토픽모델 링 방법론을 활용하여 잠재적 이슈를 추론하였다. 분석 결과 잠재적인 이슈로는 ‘법안 강화’, ‘여성･아 동･가족’, ‘범죄 수사’, ‘사회문제’ 등이 도출되어 관련 정책 및 법안 강화에 대한 논의가 필요하다. 국 민청원에 등록되는 이슈가 온라인 공간에서 확대되어 혁신적 사회 의제로 연결될 수 있기에 전자청원 제도의 정보 흐름과 정책의제를 관리하는 기능도 중요하지만, 의제로 발생한 문제를 해결하고 제도 및 정책을 강화하는 역량과 역할도 함께 요구된다.},
	language = {ko},
	number = {1},
	urldate = {2024-01-25},
	journal = {정부행정},
	author = {남현동 and 김송은 and 오민정 and 남태우},
	month = jun,
	year = {2022},
	keywords = {e-petition, e-petition platform strategy, potential social issues, topic modeling, 잠재된 사회적 이슈, 전자청원 플랫폼 전략, 전자청원제도, 토픽 모델링},
	pages = {35--63},
}

@article{chang_petition_agenda_setting_2021,
	title = {국민청원의 쟁점과 의제설정},
	volume = {24},
	issn = {2671-9398},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE10573192},
	doi = {10.15235/jir.2021.06.24.2.203},
	abstract = {이 연구는 국민청원 제도의 개선 방안과 집단 의제설정의 특징을 고찰하였다. 이 연구를 수행하기 위하여 국민췅원 이슈에 대한 빅데이터 분석과 사회연결망 분석을 수행하였으며 정성적인 고찰을 부가하여 분석 결과와 시사점을 제시하였다. 분석 결과 첫째, 국민청원은 공공영역에서 아래로부터의 의제설정의 핵심 기제로 정착되었음을 확인할 수 있었다. 둘째, 전체 국민청원 건수에 비해 동의를 충족한 건수는 극소수에 불과했다. 셋째, 입법청원 또는 실질적인 입법 가능성을 내포한 국민청원 또한 매우 드물었다. 넷째, 청원이슈는 대개 강력범죄와 정치 갈등에 한정되어 이슈 본연의 중대성보다는 언론의 관심이 의제설정에 더 큰 역할을 하였다. 이러한 분석 결과는 정치 커뮤니케이션에 대한 연구에 의미 있는 시사점을 제공하는 것으로서, 공공영역에서 대안 도출 중심의 의제설정 기제가 활성화되어야 한다는 정책적 과제를 제기하고 있다.},
