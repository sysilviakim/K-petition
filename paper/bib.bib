@article{mcadam_ballots_2010,
	title = {Ballots and {Barricades}: {On} the {Reciprocal} {Relationship} between {Elections} and {Social} {Movements}},
	volume = {8},
	issn = {1541-0986, 1537-5927},
	shorttitle = {Ballots and {Barricades}},
	url = {https://www.cambridge.org/core/journals/perspectives-on-politics/article/ballots-and-barricades-on-the-reciprocal-relationship-between-elections-and-social-movements/2BE3676E7CB9655ECA4D1BDCEE64D94F},
