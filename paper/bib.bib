	shorttitle = {On the {Justifiability} of {Compulsory} {Voting}},
	url = {https://www.cambridge.org/core/journals/british-journal-of-political-science/article/on-the-justifiability-of-compulsory-voting-reply-to-lever/DDB4398A68C0F98BD2794F2605C19415},
