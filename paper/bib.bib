	note = {Publisher: Taylor \& Francis
\_eprint: https://doi.org/10.1080/07350015.2018.1462710},
	keywords = {Balancing, C31, C52, Hausman test, Robustness checks, Specification testing, Variable addition.},
	pages = {205--216},
}

