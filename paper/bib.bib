@incollection{kacprzyk_quality_2007,
	address = {Berlin, Heidelberg},
	title = {Quality and {Complexity} {Measures} for {Data} {Linkage} and {Deduplication}},
	volume = {43},
	isbn = {978-3-540-44911-9 978-3-540-44918-8},
	url = {http://link.springer.com/10.1007/978-3-540-44918-8_6},
	abstract = {Deduplicating one data set or linking several data sets are increasingly important tasks in the data preparation steps of many data mining projects. The aim of such linkages is to match all records relating to the same entity. Research interest in this area has increased in recent years, with techniques originating from statistics, machine learning, information retrieval, and database research being combined and applied to improve the linkage quality, as well as to increase performance and eﬃciency when linking or deduplicating very large data sets. Diﬀerent measures have been used to characterise the quality and complexity of data linkage algorithms, and several new metrics have been proposed. An overview of the issues involved in measuring data linkage and deduplication quality and complexity is presented in this chapter. It is shown that measures in the space of record pair comparisons can produce deceptive quality results. Various measures are discussed and recommendations are given on how to assess data linkage and deduplication quality and complexity.},
	language = {en},
	urldate = {2020-12-05},
	booktitle = {Quality {Measures} in {Data} {Mining}},
	publisher = {Springer Berlin Heidelberg},
	author = {Christen, Peter and Goiser, Karl},
