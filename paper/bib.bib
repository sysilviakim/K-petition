	url = {http://www.jstor.org/stable/2240822},
	abstract = {Tukey's jackknife estimate of variance for a statistic S(X1, X2, ⋯, Xn) which is a symmetric function of i.i.d. random variables Xi, is investigated using an ANOVA-like decomposition of S. It is shown that the jackknife variance estimate tends always to be biased upwards, a theorem to this effect being proved for the natural jackknife estimate of \${\textbackslash}operatorname\{Var\} S(X\_1, X\_2, {\textbackslash}cdots, X\_\{n-1\})\$ based on X1, X2, ⋯, Xn.},
