	url = {http://www.cambridge.org/core/journals/state-politics-and-policy-quarterly/article/abs/does-public-election-funding-create-more-extreme-legislators-evidence-from-arizona-and-maine/5EB3F84A3218AA1151743C72D37AAD5E},
	doi = {10.1177/1532440014563682},
	abstract = {We investigate whether Maine and Arizona's Clean Elections laws, which provide public funding for state legislative candidates, are responsible for producing a new cadre of legislators who are unusually ideologically extreme. We find that there is essentially no important difference in the legislative voting behavior of “clean” funded legislators and traditionally funded ones in either Arizona or Maine: those who are financed by private donors are no more or less ideologically extreme than those who are supported by the state. This finding calls into question some concerns about the effects on polarization of money generally and public funding in particular.},
	number = {1},
