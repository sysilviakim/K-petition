	month = dec,
	year = {2018},
	keywords = {Political Science / American Government / General, Political Science / General, Political Science / Political Ideologies / Democracy, Political Science / Political Ideologies / General, Political Science / Political Process / Campaigns \& Elections, Social Science / Sociology / General},
