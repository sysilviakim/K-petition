	volume = {30},
	copyright = {2005 Comparative Legislative Research Center at the University of Iowa},
	issn = {1939-9162},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.3162/036298005X201671},
	doi = {10.3162/036298005X201671},
	abstract = {In this article, we discuss how donor and recipient characteristics affected the incidence and timing of political action committee (PAC) contributions to incumbent members of the U.S. House of Representatives during the 1993-94 election cycle. We contribute to the campaign finance literature by modeling the timing of contributions, which is important because timing affects the perception of political actors about the competitiveness of elections and the loci of power among members of Congress, interest groups, and between members of Congress and interest groups. Split-population event history models allow us to compare and contrast determinants of whether and when contributions are made across various types and sizes of PACs.},
	language = {en},
	number = {4},
	urldate = {2024-03-08},
	journal = {Legislative Studies Quarterly},
	author = {Box-Steffensmeier, Janet M. and Radcliffe, Peter M. and Bartels, Brandon L.},
	year = {2005},
	pages = {549--579},
}

@article{mccarty_time_2000,
	title = {The {Time} to {Give}: {PAC} {Motivations} and {Electoral} {Timing}},
	volume = {8},
	issn = {1047-1987, 1476-4989},
	shorttitle = {The {Time} to {Give}},
	url = {https://www.cambridge.org/core/journals/political-analysis/article/abs/time-to-give-pac-motivations-and-electoral-timing/F24EE7CC5E69BA2AAE438BC385C380FD},
	doi = {10.1093/oxfordjournals.pan.a029815},
	abstract = {There has been much discussion about how members of Congress desire money early in the campaign season. However, theoretical models of how contributions are allocated during the electoral cycle have been lacking. Our analysis attempts to remedy this gap by providing and testing a model which specifies how the process of bargaining between members of Congress and organized interests produces the pattern of donations observed over the course of the electoral cycle. Most notably, our results suggest that strategic incumbents can receive money early in the campaign if they desire but that they are generally unwilling to pay the price of lower aggregate fundraising and greater provision of access. These findings buttress earlier empirical findings that question the instrumental value of early money. In addition, our results highlight that contribution choices are fundamentally influenced by short-term factors, especially electoral conditions, that do not lend themselves to the routinized behavior necessary for contributors to invest in incumbents for long-run payoffs.},
	language = {en},
	number = {3},
	urldate = {2024-03-08},
	journal = {Political Analysis},
	author = {McCarty, Nolan and Rothenberg, Lawrence S.},
	year = {2000},
	pages = {239--259},
}

