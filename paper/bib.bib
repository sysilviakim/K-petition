@article{stuckatz_how_2021,
	title = {How the {Workplace} {Affects} {Employee} {Political} {Contributions}},
	issn = {0003-0554, 1537-5943},
	url = {http://www.cambridge.org/core/journals/american-political-science-review/article/how-the-workplace-affects-employee-political-contributions/321FE86C3B93DBBD59FF6A30F0ECF7D1},
	doi = {10.1017/S0003055421000836},
	abstract = {How important is the workplace for employees’ political donations? Contrary to research on workplace political mobilization, existing work assumes that most individual donors contribute ideologically. I link donations of employees and Political Action Committees (PACs) from 12,737 U.S. public companies between 2003 and 2018 to show that 16.7\% of employee donations go to employer-PAC-supported candidates. I investigate the dynamics between employee and PAC donations within firm–legislator pairs over time and find that both rank-and-file employees and executives contribute more dollars to company-supported politicians. Firm–employee donation alignment is stronger on powerful and ideologically moderate politicians with high value for the employer. Results from a difference-in-differences design further show modest changes in the partisan composition of employee donations after swift changes in the partisan donations of corporate PACs. The results suggest investment-related rather than ideological motives for alignment and highlight the importance of corporations for money in politics.},
	urldate = {2021-12-16},
	journal = {American Political Science Review},
	author = {Stuckatz, Jan},
	year = {2021},
	pages = {1--16},
}

@article{sebold_evolution_2020,
	title = {The {Evolution} of {Independent} {Expenditures} in {U}.{S}. {Federal} {Elections} {Before} and {After} {Citizens} {United}},
	volume = {35},
	issn = {1771-8848},
	url = {https://www.cairn.info/revue-politique-americaine-2020-2-page-47.htm},
	abstract = {L\&\#8217;une des caract\&\#233;ristiques distinctes du financement des campagnes \&\#233;lectorales aux \&\#201;tats-Unis est le r\&\#244;le important que jouent les d\&\#233;penses ind\&\#233;pendantes (DI) des groupes et des individus dans le financement des \&\#233;lections. Les critiques des d\&\#233;penses ind\&\#233;pendantes accusent ces derni\&\#232;res d\&\#8217;accro\&\#238;tre la polarisation partisane, de diminuer la transparence politique et d\&\#8217;exacerber l\&\#8217;influence disproportionn\&\#233;e de certains int\&\#233;r\&\#234;ts \&\#233;conomiques. Le Congr\&\#232;s a tent\&\#233; de r\&\#233;guler les d\&\#233;penses ind\&\#233;pendantes dans les ann\&\#233;es 1970 avec la loi sur la r\&\#233;forme des campagnes \&\#233;lectorales f\&\#233;d\&\#233;rales, mais en 1976, la Cour supr\&\#234;me des \&\#201;tats-Unis en a fortement r\&\#233;duit la r\&\#233;glementation tant qu\&\#8217;elles ne sont pas utilis\&\#233;es pour soutenir ou s\&\#8217;opposer express\&\#233;ment \&\#224; un candidat. Bien que la d\&\#233;cision de 2010 de la Cour dans l\&\#8217;affaire Citizens United contre Federal Election Commission soit souvent accus\&\#233;e, \&\#224; juste titre, d\&\#8217;amplifier l\&\#8217;influence des d\&\#233;penses ind\&\#233;pendantes, nous soutenons que c\&\#8217;est une interdiction ant\&\#233;rieure du \&\#171;\&\#160;soft money\&\#160;\&\#187; qui a en fait conduit \&\#224; l\&\#8217;augmentation de ce type d\&\#8217;activit\&\#233; \&\#233;lectorale. L\&\#8217;interdiction du \&\#171;\&\#160;soft money\&\#160;\&\#187; est advenue en 2002 avec la loi sur la r\&\#233;forme des campagnes \&\#233;lectorales bipartites (Bipartisan Campaign Reform Act, BCRA), mais les groupes ont r\&\#233;agi en orientant l\&\#8217;argent des partis politiques vers des comit\&\#233;s ext\&\#233;rieurs. L\&\#8217;interdiction du \&\#171;\&\#160;soft money\&\#160;\&\#187; par la BCRA et ses restrictions sur les DI ont \&\#233;galement incit\&\#233; les groupes \&\#224; organiser des contestations judiciaires, dont l\&\#8217;une a finalement abouti \&\#224; l\&\#8217;affaire Citizens United. L\&\#8217;effort de d\&\#233;r\&\#233;glementation des activit\&\#233;s des groupes d\&\#8217;int\&\#233;r\&\#234;t lors des \&\#233;lections s\&\#8217;est poursuivi bien apr\&\#232;s l\&\#8217;affaire Citizens. Bien que les donn\&\#233;es sur les effets des diff\&\#233;rentes d\&\#233;cisions de la Cour supr\&\#234;me, des arr\&\#234;ts de la Cour f\&\#233;d\&\#233;rale et des avis consultatifs de la FEC offrent des r\&\#233;sultats mitig\&\#233;s, nous constatons un changement notable dans la port\&\#233;e de ces DI. Alors qu\&\#8217;elles \&\#233;taient \&\#224; l\&\#8217;origine utilis\&\#233;es par des groupes principalement pour encourager les candidatures de certains candidats \&\#224; des fonctions \&\#233;lectives, elles sont maintenant de plus en plus utilis\&\#233;es pour cibler et attaquer les opposants.},
	number = {2},
	urldate = {2021-12-15},
	journal = {Politique americaine},
	author = {Sebold, Karen and Dowdle, Andrew},
	year = {2020},
	pages = {47--66},
}

@article{sebold_can_2018,
	title = {Can “{Letting} in {Sunlight}” {Lead} to {Accidental} {Sunburn}? {The} {Unintended} {Consequences} of {Campaign} {Finance} {Reform} on the {Financing} of {U}.{S}. {Presidential} {Candidates}},
	volume = {17},
	issn = {1533-1296},
	shorttitle = {Can “{Letting} in {Sunlight}” {Lead} to {Accidental} {Sunburn}?},
	url = {https://www.liebertpub.com/doi/full/10.1089/elj.2018.0517},
	doi = {10.1089/elj.2018.0517},
	abstract = {Changes in campaign finance or other electoral laws often have unintended consequences. We demonstrate this effect by examining how the 2002 Bipartisan Campaign Reform Act helped alter the makeup of small, medium, and large dollar donors in the critical period known as the “invisible primary” before the Iowa Caucuses. The original concerns were that a few large dollar contributors would play a disproportionate role in funding bids and that candidates who had the ability to attract these large contributions would gain an unfair advantage. To measure the effects on contributor behavior, we examine candidate reports filed with the Federal Election Commission during the 2000–2016 presidential preprimaries. We find the impact and number of small contributions increased significantly following the passage of the 2002 legislation while the midsize and large contributions decreased. More importantly, this shift occurred well in advance of the Supreme Court's rulings prior to the 2012 contest. While this trend does have some positive aspects, we argue the decline of the midsize contributor will impact how nomination hopefuls fund their campaigns and eventually may undermine the political parties as entities themselves that are independent of the well-funded super PACs that have arisen in recent years.},
	number = {3},
	urldate = {2021-12-15},
	journal = {Election Law Journal: Rules, Politics, and Policy},
	author = {Sebold, Karen and Dowdle, Andrew J.},
	year = {2018},
	keywords = {American political behavior, Bipartisan Campaign Reform Act, campaign finance reform, invisible primary, presidential nomination politics},
	pages = {209--220},
}

@article{pastine_soft_2013,
	title = {Soft {Money} and {Campaign} {Finance} {Reform}},
	volume = {54},
	issn = {1468-2354},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/iere.12030},
	doi = {10.1111/iere.12030},
	abstract = {We analyze special interest influence on policy when political contributions are capped but the regulation contains soft-money loopholes. The politician chooses between two policy options. We define special interest influence as the probability the politician chooses the policy he would not have chosen in the absence of contributions. Any binding cap reduces special interest influence but the effect may be nonmonotonic. A ban on contributions can result in greater special interest influence than a binding but nonzero cap. The results may also have implications for the policy response to the 2010 Supreme Court ruling on Citizens United v. FEC.},
	number = {4},
	urldate = {2021-12-15},
	journal = {International Economic Review},
	author = {Pastine, Ivan and Pastine, Tuvana},
	year = {2013},
	pages = {1117--1131},
}

@article{pastine_incumbency_2012,
	title = {Incumbency advantage and political campaign spending limits},
	volume = {96},
	issn = {0047-2727},
	url = {https://www.sciencedirect.com/science/article/pii/S0047272711001290},
	doi = {10.1016/j.jpubeco.2011.07.002},
	abstract = {This paper presents a model which captures the three main arguments for and against campaign spending limits. Campaign spending limits are purported to restrict the incumbent's ability to exploit his fundraising advantage. In contrast to conventional wisdom, a ceiling increases the incumbent's probability of victory regardless of the candidates' relative fundraising abilities as long as the challenger is not more effective in campaign spending. If the challenger is more effective in campaign spending, ceilings have a non-monotonic effect when the incumbent enjoys a mild initial voter disposition advantage; A moderate ceiling decreases the incumbent's probability of victory but further restricting the limit favors the incumbent. Irrespective of incumbency status, the marginal benefit to quality decreases with a more restrictive cap. In an open-seat contest, a more restrictive limit improves the electoral prospects of the superior quality candidate. Stricter ceilings may lead to the unintended consequence of increased expected spending.},
	number = {1},
	urldate = {2021-12-15},
	journal = {Journal of Public Economics},
	author = {Pastine, Ivan and Pastine, Tuvana},
	year = {2012},
	keywords = {Campaign finance legislation, Contest, Expenditure limit, Head-start advantage, Preferential treatment all-pay auction, Spending cap},
	pages = {20--32},
}

@article{nwokora_distinctive_2014,
	title = {The distinctive politics of campaign finance reform},
	volume = {20},
	issn = {1354-0688},
	url = {https://doi.org/10.1177/1354068812462922},
	doi = {10.1177/1354068812462922},
	abstract = {This article presents a unified theory explaining several conflicting empirical observations in the politics of campaign finance. It identifies those circumstances that foster or frustrate the enactment of financing laws that increase the competitiveness of elections. I argue that the competitiveness of financing laws is a result of three strong incentives when they operate in differently structured party systems. First, lawmakers have an incentive to make laws to protect their incumbency from competitors. This incentive generally overwhelms the (weaker) incentive to enact popular, competition-enhancing reforms. Secondly, lawmakers, when they act through political parties, have an incentive to cooperate with rivals to reduce the costs of political defeats. Thirdly, lawmakers seek to enact reforms that are consistent with their normative goals. These incentives combine with several party system variables to determine when campaign finance reform is likely to occur and how it will impact on the competitiveness of elections.},
	number = {6},
	urldate = {2021-12-15},
	journal = {Party Politics},
	author = {Nwokora, Zim},
	year = {2014},
	keywords = {Campaign and finance law, causal model, office goals, policy goals, political parties},
	pages = {918--929},
}

@article{neron_rethinking_2016,
	title = {Rethinking the {Ethics} of {Corporate} {Political} {Activities} in a {Post}-{Citizens} {United} {Era}: {Political} {Equality}, {Corporate} {Citizenship}, and {Market} {Failures}},
	volume = {136},
	issn = {1573-0697},
	shorttitle = {Rethinking the {Ethics} of {Corporate} {Political} {Activities} in a {Post}-{Citizens} {United} {Era}},
	url = {https://doi.org/10.1007/s10551-015-2867-y},
	doi = {10.1007/s10551-015-2867-y},
	abstract = {The aim of this paper is to provide some insights for a normative theory of corporate political activities (CPAs). Such a theory aims to provide theoretical tools to investigate the legitimacy of corporate political involvement and allows us to determine which political activities and relations with government regulators are appropriate or inappropriate, permissible or impermissible, obligatory or forbidden for corporations. After having explored what I call the “normative presumption of legitimacy” of CPAs, this paper identifies three different plausible strategies to criticize and object to corporate political involvement: the “egalitarian” strategy, the “corporate citizenship” strategy, and the “market failures” strategy. It constitutes an attempt to develop the market failures approach to reflect on CPAs. My main claim is that within such an account, the idea that corporations have a license to operate considerably limits their right to engage in political activities.},
	number = {4},
	urldate = {2021-12-15},
	journal = {Journal of Business Ethics},
	author = {Néron, Pierre-Yves},
	year = {2016},
	pages = {715--728},
}

