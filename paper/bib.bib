@book{abramowitz_polarized_2012,
	title = {The {Polarized} {Public}},
	isbn = {978-0-205-91693-1},
	abstract = {This is the eBook of the printed book and may not include any media, website access codes, or print supplements that may come packaged with the bound book. Debuting in its first edition, The Polarized Public takes an in-depth look at the seemingly irreconcilable divide between Republicans and Democrats and argues that bi-partisanship remains elusive, not because of politicians in the capitol, but because of the American public and their fixation on party membership and loyalty. How did this intense polarization develop? How has it influenced the current political climate? How will it evolve and affect the upcoming presidential and congressional elections? Alan Abramowitz addresses all of these questions among others in this new, eye-opening addition to The Great Questions in Politics series.},
