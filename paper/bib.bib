	pages = {2578--2590},
}

@book{bratton_public_2005,
	title = {Public {Opinion}, {Democracy}, and {Market} {Reform} in {Africa}},
	isbn = {978-0-521-60291-4},
	abstract = {This book is a groundbreaking exploration of public opinion in sub-Saharan Africa. Based on the Afrobarometer, a survey research project, it reveals what ordinary Africans think about democracy and market reforms, subjects on which almost nothing is otherwise known. The authors find that support for democracy in Africa is wide but shallow and that Afrcns feel trapped between state and market. While Africans are learning about reform on the basis of knowledge, reasoning, and experience, few countries are likely to attain full-fledged democracies and markets anytime soonn.},
