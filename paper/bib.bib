	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE09361598},
	doi = {10.15235/jir.2020.06.23.2.155},
	abstract = {정보 네트워크 사회에서 전자민주주의가 전 세계적으로 확산되고 있다. 현대 민주주의에서 정보통신기술은 중요한 도구가 되었다. 이 연구는 전자민주주의 논의 중에서 온라인 입법청원의 가능성을 분석하고자 한다. 분석은 영국과 독일의 온라인 청원제도를 분석하고 한국적 함의를 파악하고자 했다. 연구방법론은 사례분석을 적용했다. 분석 결과, 영국과 독일의 온라인 입법청원의 특징을 제시했다. 영국과 독일 온라인 청원제도를 통하여 ICT를 이용한 청원제도의 가능성을 진단했다. 그리고 영국과 독일의 온라인 입법청원의 장점을 살펴보았다. 온라인 청원 제도가 가지는 민주주의적인 함의를 바탕으로 발전적인 제도 설계가 준비되어야 할 것이다.},
	language = {ko},
	number = {2},
	urldate = {2024-01-25},
	journal = {국제정치연구},
	author = {송경재 and 장우영},
	month = jun,
	year = {2020},
	keywords = {Germany, United Kingdom, democracy, legislation, online petitions, 독일, 민주주의, 영국, 온라인 청원, 입법},
	pages = {155--178},
}

@article{lim_petition_opinion_2022,
	title = {지방의회 청원제도를 바라보는 시민 인식에 관한 연구: 기대효과와 영향요인을 중심으로},
	volume = {26},
	issn = {1226-9573},
	shorttitle = {지방의회 청원제도를 바라보는 시민 인식에 관한 연구},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE11117857},
	doi = {10.20484/klog.26.2.1},
	abstract = {공공부문에서의 공정성, 책임성, 투명성이 강조되면서 입법과정에 대한 시민참여를 보장하는 제도적 통로인 청원제도에 대한 기대가 높아지고 있는 상황이다. 지방의회의 주민대표기능과 주민주권 강화를 위해서는 지방의회 청원제도가 활성화되어야 한다. 지방의회 청원제도의 목적 달성과 활성화를 위해서는 제도를 바라보는 시민들의 인식이 중요하다. 이러한 배경 하에서 본 연구는 청원의 제도적 기능과 운영적 측면을 종합적으로 고려하여 시민 인식을 중심으로 지방의회 청원제도의 기대효과에 관한 영향요인을 규명하고, 제도 활성화를 위한 정책적 함의들을 도출하고자 한다. 분석 결과, 청원제도와 공정성, 제도적 필요성에 대한 인식은 지방의회 청원제도의 기대효과에 정(+)의 영향을 미치는 것으로 나타났다. 연구 결과를 바탕으로 정책적 제언을 제시하면 첫째, 지방의회 청원제도에 대한 주민 인식도 제고가 필요하며 지방의회 청원제도의 효용성을 발굴해야한다. 둘째, 지방의회 청원제도의 개편 및 전자청원제도의 도입이 필요하다. 셋째, 청원제도의 효과적인 운용을 위한 지방의회의원의 인식 제고 및 역량강화가 필요하다.},
	language = {ko},
	number = {2},
	urldate = {2024-01-25},
	journal = {지방정부연구},
	author = {임정빈 and 유수동},
	month = aug,
	year = {2022},
	keywords = {Citizen Awareness, Expected Effect, Influencing Factors, Local Council, Petition System, 기대효과, 시민 인식, 영향요인, 지방의회, 청원제도},
	pages = {1--21},
}

@article{choi_petition_covid19_2021,
	title = {국민청원데이터를 활용한 코로나19 팬데믹 시대 국민들의 복지 욕구 탐색},
	volume = {52},
	issn = {1598-3854},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE10632720},
	abstract = {본 연구는 2020년 1월 1일부터 2020년 12월 31일까지 2020년 한 해 동안 보건복지로 분류된 국민청원 중 복지이슈 청원 452개 청원의 내용을 통해 코로나19 시기 국민의 복지 욕구를 도출하였다. 자료는 국민청원 웹사이트에서 웹스크래핑을 통해 수집하였으며 SPSS와 Atlas-ti를 활용하여 분석하였다. 분석 결과 2020년 한 해 동안 복지 분야 국민청원은 19개 대범주와 107개 세부범주로 분류되었으며 코로나 관련한 복지 욕구가 가장 높은 것으로 발견되었다. 이어 장애인, 요양간병, 복지시설 및 인력 관리운영, 사회, 사회보험, 아동가족, 보육, 저소득/노동/고용, 청년, 노인, 공공부조, 주거, 한부모, 정신건강, 입양, 외국노동자, 노숙인 등의 순으로 많은 관심과 욕구가 발견되었다. 대부분의 청원은 새로운 정책이나 제도를 제안하거나 기존 제도의 개선이나 보완을 제안하는 것을 목적으로 하였으며, 일부는 신고고발, 칭찬 등을 의도하였다. 이처럼 국민청원은 대체로 작게는 자신이나 자신이 속한 집단 및 지역사회의 문제 해결, 크게는 더 나은 사회와 국가를 만들기 위한 제도화를 주된 목적으로 사용되고 있었다. 본 연구는 연구 결과로부터 코로나19와 같은 질병적 재난 상황에서 복지영역의 대처와 준비, 사회적 수요와 관심이 높은 사회서비스의 제공과 전달, 청원과 같은 사회적 요구 활동에서 특정 집단의 배제 가능성과 정보 접근성의 문제, 특정 집단과 해당 집단에 속하지 않는 국민들 간의 인식의 간극과 해결, 사회복지영역의 전통적 문제에 대한 재발견과 대응, 최근 시행을 시작한 제도들의 구체적 개선 방안, 현장의 목소리를 담은 자료로서 복지 욕구 파악을 위해 국민청원자료 활용 체계 구축 필요성 등에 대한 제도적, 실천적 함의를 제공한다.},
	language = {ko},
	number = {2},
	urldate = {2024-01-25},
	journal = {사회복지연구},
	author = {최상미 and 설소희},
	year = {2021},
	keywords = {내용 분석, 복지 욕구 탐색, 청와대 국민청원, 코로나19 팬데믹},
	pages = {37--64},
}

@article{suh_assembly_petition_2021,
	title = {국회에서의 국민동의 전자청원제도의 도입, 기대효과 및 향후 과제},
	volume = {13},
	issn = {2234-0564},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE10747586},
	abstract = {국회는 2020년 1월부터 국민동의 전자청원제도를 도입했다. 30일 이내에 10만 명 이상의 동의를 얻은 청원은 국민동의 전자청원으로 접수된다. 2021년 3월 30일 현재 요건을 채운 18건의 전자청원은 법률 개정, 제도 개선 등 국민적 의사를 반영해 청원권을 효과적으로 보장하고 대의민주주의를 보완하는 기능을 수행하고 있다. 이 전자청원제도가 1년 넘게 경과한 만큼 국회는 참여 기회를 더욱 확대하고 국회와 국민 간의 정보 소통을 원활히 할 수 있도록 전자청원제도를 개선할 필요가 있다.},
	language = {ko},
	number = {3},
	urldate = {2024-01-25},
	journal = {한국IT정책경영학회 논문지},
	author = {서은철 and 민수홍 and 김진규 and 전삼현},
	year = {2021},
	keywords = {국민동의, 국회, 전자청원, 전자청원제도, 청원권},
	pages = {2467--2473},
}

