	address = {New York, NY},
	series = {Lecture {Notes} in {Statistics}},
	title = {Econometric {Computing} with “{R}”},
	isbn = {978-1-4419-1764-5},
	doi = {10.1007/978-1-4419-1764-5_1},
	abstract = {We show that the economics profession is in dire need of practitioners of econometric computing, and that “R” is the best choice for teaching econometric/statistical computing to researchers who are not numerical analysts. We give examples of econometric computing in R, and use “R” to revisit the classic papers by Longley and by Beaton, Rubin and Barone. We apply the methods of econometric computing to show that the empirical results of Donohue and Levitt’s abortion paper are numerically unsound. This discussion should be of interest in other social sciences as well.},
