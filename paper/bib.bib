	issn = {1065-9129, 1938-274X},
	url = {http://journals.sagepub.com/doi/10.1177/1065912911430671},
	doi = {10.1177/1065912911430671},
	abstract = {Voter registration is thought to have a substantial negative effect on American voter turnout. The authors clarify this understanding in two ways. First, using a natural experiment in Wisconsin, they estimate the pure effect of registration, stripped of aspects such as the closing date. Registration lowers turnout by about 2 percentage points. Second, the authors argue that administrative capacities of local election officials are important moderators of how much registration affects turnout. Municipalities with less capacity are associated with bigger decreases in turnout. Researchers and policy makers should consider administrative capacity as a component in the equal application of voting laws.},
