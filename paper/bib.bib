@article{feder_voter_2020,
	title = {Voter {Purges} {After} {Shelby}: {Part} of {Special} {Symposium} on {Election} {Sciences}},
	volume = {48},
	issn = {1532-673X},
	shorttitle = {Voter {Purges} {After} {Shelby}},
	url = {https://doi.org/10.1177/1532673X20916426},
	doi = {10.1177/1532673X20916426},
	abstract = {In Shelby County v. Holder (570 U.S. 529 (2013)), the U.S. Supreme Court struck down the “coverage formula” in Section 4b of the Voting Rights Act (VRA) that determined which jurisdictions had to presubmit changes in their election policies for federal approval. This ruling allowed covered counties full control over their election laws for the first time in 40 years. We engage the question of whether counties that had previously been “covered” purged voters at a higher rate than noncovered counties after the coverage formula was struck down. We find increases in purge rate of between 1.5 and 4.5 points in formerly covered jurisdictions post-Shelby, compared with counties that had not been subject to preclearance. Most of the increase came immediately, as the effect in 2014 is substantively and significantly higher than that in 2016. These findings suggest that while counties may have aggressively purged voters in 2014—the first election after the coverage formula’s demise—they may have tempered this behavior thereafter.},
	language = {en},
	number = {6},
	urldate = {2022-08-05},
	journal = {American Politics Research},
	author = {Feder, Catalina and Miller, Michael G.},
	year = {2020},
	keywords = {Shelby County v. Holder, Voting Rights Act, elections, voter purges},
	pages = {687--692},
}

@article{hassell_adam_2017,
	title = {Adam {Seth} {Levine}. {American} {Insecurity}: {Why} {Our} {Economic} {Fears} {Lead} to {Political} {Inaction}. {Princeton}, {NJ}: {Princeton} {University} {Press}. 2015. 320 pp. \$29.95 (cloth). \$23.95 (paper)},
	volume = {81},
	issn = {0033-362X},
	shorttitle = {Adam {Seth} {Levine}. {American} {Insecurity}},
	url = {https://doi.org/10.1093/poq/nfx027},
	doi = {10.1093/poq/nfx027},
	abstract = {Adam Seth Levine’s key argument in American Insecurity: Why Our Economic Fears Lead to Political Inaction is that groups seeking to act on a certain subset of financial insecurity issues face higher barriers to collective action than normal in their attempts to mobilize individuals to engage politically. Although Levine’s book carries the title American Insecurity, the book’s major contribution is not economic or even an understanding of the success of certain interest groups, but rather a better understanding of how some types of political rhetoric motivate (or fail to motivate) political behavior. While the specific application of the work in this book is helpful in shedding light on the success, or lack thereof, of certain subsets of public interest groups, Levine’s more meaningful contribution to our understanding of political behavior is the broader explanation of the self-undermining nature of certain political rhetoric.},
	number = {3},
	urldate = {2021-12-12},
	journal = {Public Opinion Quarterly},
	author = {Hassell, Hans},
	year = {2017},
	pages = {793--795},
}

