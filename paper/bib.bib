@article{green_encouraging_2015,
	title = {Encouraging {Small} {Donor} {Contributions}: {A} {Field} {Experiment} {Testing} the {Effects} of {Nonpartisan} {Messages}},
	volume = {2},
	issn = {2052-2630, 2052-2649},
	shorttitle = {Encouraging {Small} {Donor} {Contributions}},
	url = {http://www.cambridge.org/core/journals/journal-of-experimental-political-science/article/abs/encouraging-small-donor-contributions-a-field-experiment-testing-the-effects-of-nonpartisan-messages/A5FA006A444E37CAD71D584CFFAF169C},
	doi = {10.1017/XPS.2015.1},
	abstract = {We report the results of a field experiment conducted in New York City during the 2013 election cycle, examining the impact of nonpartisan messages on donations from small contributors. Using information from voter registration and campaign finance records, we built a forecasting model to identify voters with an above-average probability of donating. A random sample of these voters received one of four messages asking them to donate to a candidate of their choice. Half of these treatments reminded voters that New York City's campaign finance program matches small donations with public funds. Candidates’ financial disclosures to the city's Campaign Finance Board reveal that only the message mentioning policy (in generic terms) increased donations. Surprisingly, reminding voters that matching funds multiplied the value of their contribution had no effect. Our experiment sheds light on the motivations of donors and represents the first attempt to assess nonpartisan appeals to contribute.},
	number = {2},
	urldate = {2021-08-11},
	journal = {Journal of Experimental Political Science},
	author = {Green, Donald P. and Krasno, Jonathan S. and Panagopoulos, Costas and Farrer, Benjamin and Schwam-Baird, Michael},
	year = {2015},
	keywords = {Campaign finance, donations, electoral politics, field experiments, political participation},
	pages = {183--191},
}

@article{boatright_political_2005,
	title = {Political {Contribution} {Tax} {Credits} and {Citizen} {Participation}},
	volume = {33},
	issn = {1532-673X},
	url = {https://doi.org/10.1177/1532673X04273418},
	doi = {10.1177/1532673X04273418},
	abstract = {This article discusses political contribution tax credits, a campaign finance reform that seeks to encourage participation. Several states provide citizens with tax credits for part or all of their contributions to state or local candidates. Although a fewstudies have tried to estimate the budgetary impact of such programs, none has analyzed the effects of these tax credits on the propensity of citizens to contribute. We discuss the results of two surveys in one state with tax credits, Ohio? one survey each of the general public and of campaign contributors. Our results indicate that if citizens are made aware of the tax credits, they have the potential to attract donors who are more similar to the general public than the current pool of campaign contributors. Tax credits have the greatest effect on small contributors, on younger adults, and on less partisan individuals.},
	number = {6},
	urldate = {2023-04-24},
	journal = {American Politics Research},
	author = {Boatright, Robert G. and Malbin, Michael J.},
	year = {2005},
	pages = {787--817},
}

