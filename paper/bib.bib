	year = {2002},
	doi = {10.1007/978-1-4615-0569-3_2},
	keywords = {Female Candidate, Gender Stereotype, Male Candidate, Sexual Harassment, Woman Candidate},
	pages = {29--53},
}

@incollection{sears_role_2001,
	address = {New York, NY, US},
	series = {Cambridge studies in political psychology and public opinion},
	title = {The role of affect in symbolic politics},
	isbn = {978-0-521-59376-2},
	abstract = {Discusses the role of affect in symbolic politics by summarizing and elaborating an enduring research program that has influenced public opinion and political psychology work for years. The author argues that individuals learn "symbolic predispositions" early in life, and these predispositions strongly condition how people respond to political words and symbols in their current political environments. The affect in his theory, in other words, has roots that go back to childhood. The symbolic politics theory comports with all we know about the nature of ordinary citizens: they know little about politics; they profess only minimal interest in politics; they see politics as distant and complex. Symbolic reactions provide a quick and easy way for people to break through the complexity of politics and render political evaluations. The author extends his theory by demonstrating that symbolic processing, which takes the form of strong affective responses to symbols, comports with current research into how people process information from their environments. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
	booktitle = {Citizens and politics:  {Perspectives} from political psychology},
	publisher = {Cambridge University Press},
