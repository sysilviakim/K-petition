	title = {When {Do} {Voters} {Reward} {Overtly} {Religious} {Appeals}?},
	issn = {0022-3816},
	url = {https://www.journals.uchicago.edu/doi/abs/10.1086/730747},
	doi = {10.1086/730747},
	urldate = {2024-04-26},
