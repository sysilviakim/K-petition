@article{coppock_when_2016,
	title = {When {Treatments} are {Tweets}: {A} {Network} {Mobilization} {Experiment} over {Twitter}},
	volume = {38},
	copyright = {Springer Science+Business Media New York 2016},
	issn = {01909320},
	shorttitle = {When {Treatments} are {Tweets}},
	url = {https://www.proquest.com/docview/1771298872/abstract/485BF5EA5DFC4074PQ/1},
	doi = {10.1007/s11109-015-9308-6},
	abstract = {This study rigorously compares the effectiveness of online mobilization appeals via two randomized field experiments conducted over the social microblogging service Twitter. In the process, we demonstrate a methodological innovation designed to capture social effects by exogenously inducing network behavior. In both experiments, we find that direct, private messages to followers of a nonprofit advocacy organization's Twitter account are highly effective at increasing support for an online petition. Surprisingly, public tweets have no effect at all. We additionally randomize the private messages to prime subjects with either a "follower" or an "organizer" identity but find no evidence that this affects the likelihood of signing the petition. Finally, in the second experiment, followers of subjects induced to tweet a link to the petition are more likely to sign it--evidence of a campaign gone "viral." In presenting these results, we contribute to a nascent body of experimental literature exploring political behavior in online social media.},
	language = {English},
	number = {1},
	urldate = {2023-04-24},
	journal = {Political Behavior},
	author = {Coppock, Alexander and Guess, Andrew and Ternovski, John},
	month = mar,
	year = {2016},
	note = {Num Pages: 105-128
Place: New York, Netherlands
Publisher: Springer Nature B.V.},
	keywords = {Field experiments, Networks, Political participation},
	pages = {105--128},
}

