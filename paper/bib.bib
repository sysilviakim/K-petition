@article{shieh_individual_2010,
	title = {Individual campaign contributions in a {Downsian} model: expressive and instrumental motives},
	volume = {145},
	issn = {0048-5829, 1573-7101},
	shorttitle = {Individual campaign contributions in a {Downsian} model},
	url = {http://link.springer.com/10.1007/s11127-009-9572-2},
	doi = {10.1007/s11127-009-9572-2},
	abstract = {We investigate in a Downsian framework the possibility of and rationale for individual campaign contributions under various combinations of voters’ and candidates’ objective functions. We ﬁrst show in a simple voting model that expressive motives might give rise to contributions and separated positions, while instrumental motives will not. We then show in a probabilistic voting model that both motives could lead to giving and policy divergence. However, when this is the case, positions are more separated, contributions are greater, and society’s welfare is higher when motives are expressive than when motives are instrumental.},
	number = {3-4},
	urldate = {2020-06-30},
	journal = {Public Choice},
	author = {Shieh, Shiou and Pan, Wan-Hsiang},
	year = {2010},
	pages = {405--416},
}

