@incollection{estlund_epistemic_2018,
	edition = {1},
	title = {The {Epistemic} {Value} of {Democratic} {Deliberation}},
	isbn = {978-0-19-874736-9 978-0-19-180969-9},
	url = {https://academic.oup.com/edited-volume/28086/chapter/212134018},
	abstract = {Abstract
            Recently, some normative approaches to democracy have emphasized its actual or aspirational epistemic value—a tendency to make good or correct decisions. While some accounts explain how such value might arise in a broadly statistical and probabilistic way, other accounts emphasize ways in which interpersonal political deliberation might have epistemic value of the right kind. Epistemic democratic deliberation plays a role in some traditional approaches, but it has been more prominent in recent decades. In this chapter we explain and discuss approaches which consider mechanisms by which democratic deliberation might have epistemic value, and also approaches which focus on the role that such a hypothesized epistemic value might play in an account of the authority or justification of democratic arrangements.},
	language = {en},
	urldate = {2025-07-29},
	booktitle = {The {Oxford} {Handbook} of {Deliberative} {Democracy}},
	publisher = {Oxford University Press},
	author = {Estlund, David and Landemore, Hélène},
	editor = {Bächtiger, Andre and Dryzek, John S. and Mansbridge, Jane and Warren, Mark D.},
