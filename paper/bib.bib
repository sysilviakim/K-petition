@article{altman_accuracy_2007,
	title = {accuracy: {Tools} for {Accurate} and {Reliable} {Statistical} {Computing}},
	volume = {21},
	copyright = {Copyright (c) 2006 Micah Altman, Jeff Gill, Michael P. McDonald},
	issn = {1548-7660},
	shorttitle = {accuracy},
	url = {https://doi.org/10.18637/jss.v021.i01},
	doi = {10.18637/jss.v021.i01},
	abstract = {Most empirical social scientists are surprised that low-level numerical issues in software can have deleterious effects on the estimation process. Statistical analyses that appear to be perfectly successful can be invalidated by concealed numerical problems. We have developed a set of tools, contained in accuracy, a package for R and S-PLUS, to diagnose problems stemming from numerical and measurement error and to improve the accuracy of inferences. The tools included in accuracy include a framework for gauging the computational stability of model results, tools for comparing model results, optimization diagnostics, and tools for collecting entropy for true random numbers generation.},
	language = {en},
	urldate = {2022-10-31},
	journal = {Journal of Statistical Software},
	author = {Altman, Micah and Gill, Jeff and McDonald, Michael P.},
	month = jul,
	year = {2007},
	pages = {1--30},
}

@article{gill_what_2004,
	title = {What to {Do} {When} {Your} {Hessian} is {Not} {Invertible}: {Alternatives} to {Model} {Respecification} in {Nonlinear} {Estimation}},
	volume = {33},
	issn = {0049-1241},
	shorttitle = {What to {Do} {When} {Your} {Hessian} is {Not} {Invertible}},
	url = {https://doi.org/10.1177/0049124103262681},
	doi = {10.1177/0049124103262681},
	abstract = {What should a researcher do when statistical analysis software terminates before completion with a message that the Hessian is not invertible? The standard textbook advice is to respecify the model, but this is another way of saying that the researcher should change the question being asked. Obviously, however, computer programs should not be in the business of deciding what questions are worthy of study. Although noninvertable Hessians are sometimes signals of poorly posed questions, nonsensical models, or inappropriate estimators, they also frequently occur when information about the quantities of interest exists in the data through the likelihood function. The authors explain the problem in some detail and lay out two preliminary proposals for ways of dealing with noninvertable Hessians without changing the question asked.},
	language = {en},
	number = {1},
	urldate = {2022-10-31},
	journal = {Sociological Methods \& Research},
	author = {Gill, Jeff and King, Gary},
	month = aug,
	year = {2004},
	note = {Publisher: SAGE Publications Inc},
	pages = {54--87},
}

