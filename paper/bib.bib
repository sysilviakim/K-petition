@article{lee_topicmodel_petition_2021,
	title = {관리도를 활용한 국민청원 토픽 모니터링 연구},
	volume = {34},
	issn = {1225-066X},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE11407751},
	abstract = {최근 온라인 채널을 통한 텍스트 자료가 방대해 지면서 이를 요약하고 분석하는 연구에 관한 관심이 커지고 있는 추세이다. 먼저 텍스트 자료에 대한 기본적인 분석 중 하나는 어떤 주제나 내용을 포함하고 있는지 잠재된 토픽을 추출하는 것이다. 연구자가 일일이 모든 자료를 읽고 내용을 요약할 수도 있겠지만, 대용량 데이터를 다루는 경우에는 결코 쉽지 않기 때문에, 통계적 모형을 사용하여 토픽을 추출하는 토픽모형 방법들이 제안되어 왔다 (Blei와 Lafferty, 2007; Blei 등, 2003). 시간에 따라 수집된 텍스트 데이터로부터 토픽의 변화를 모니터링하기 위하여, 본 연구에서는 잠재적 디리슈레 할당(latent Dirichlet allocation) 모형을 통해 토픽을 분류하고 그 결과를 바탕으로 한 토픽 지수를 제안하였다. 또한, 이를 통계적공정관리의 대표적 도구인 관리도에 적용하여 시간 경과에 따른 토픽의 변화를 모니터링하는 데 적용해 보았다. 실제 데이터로 2018년 3월 5일부터 2020년 3월 5일 사이에 청와대 국민청원 온라인 게시판에 접수된 텍스트 데이터를 사용하였으며, 토픽 지수를 모니터링함으로써 토픽에 대한 이상변화를 탐지할 수 있음을 살펴 보았다.},
	language = {ko},
	number = {5},
	urldate = {2024-01-25},
	journal = {응용통계연구},
	author = {이희연 and 최지은 and 이성임 and 손원},
	month = oct,
	year = {2021},
	keywords = {EWMA chart, EWMA 관리도, LDA model, LDA 모형, text data, topic monitoring, 텍스트 데이터, 토픽 모니터링},
	pages = {795--806},
}

@article{hwang_insanity_petition_2021,
	title = {전자청원과 온라인 이슈 공중 관계의 형성: 청와대 국민청원에서 심신미약 이슈를 중심으로},
	volume = {32},
	issn = {1225-8652},
	shorttitle = {전자청원과 온라인 이슈 공중 관계의 형성},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE10673875},
	doi = {10.53865/KSPA.2021.11.32.3.1},
	abstract = {청와대 국민청원이 사회문제를 공중 의제로 전환하는 시민 참여방식이라는 인식이 확산되고 있으나 이것이 갖는 민주적 효과는 아직 명확하지 않다. 본 연구에서는 청와대 국민청원 나아가서는 전자청원에서 나타나는 폭발적인 서명 증가와 그에 따른 정부의 공식적 답변을 넘어서서 전자청원이 제도적 성공 문턱을 넘는 경우에 온라인 이슈 공중 관계에 어떤 효과를 가질 수 있는지에 대해 살펴보았다. 이를 위해 강서구 PC방 사건에 대한 청원 제출이 야기한 심신미약 이슈에 대해 청원의 생애주기를 고려한 시계열 네트워크 데이터를 수집하였으며 네트워트 추론 통계 분석인 ERGM을 활용하였다. 분석 결과, 전자청원이 제도적 성공 문턱을 넘는 과정에서 경험하는 폭발적인 집단행동의 참여가 온라인 이슈 공중 관계에 직접적으로 영향을 미치는 것으로 나타나지 않았다. 반면에, 청원을 통해 제기된 심신미약 이슈에 청원 답변 완료 이후에까지 지속적으로 관심을 가진 행위자들은 온라인 이슈 공중 관계를 더 많이 형성하는 경향성을 확인하였다. 이를 통해 전자청원을 평가하는 데 있어서 정부의 공식적 답변의 내용에 기반하여 ‘모 아니면 도’ 식으로 평가하는 것을 넘어서서 전자청원이 시민들의 이슈에 대한 지속적인 관심을 유발할 수 있는지가 중요할 수 있음을 이론적인 함의로서 제시하였다.},
	language = {ko},
	number = {3},
	urldate = {2024-01-25},
	journal = {한국사회와 행정연구},
	author = {황한찬 and 엄석진},
	month = nov,
	year = {2021},
	keywords = {Blue House National E-petition, ERGM, e-petition, online issue relationships, 온라인 이슈 공중 관계, 전자청원, 청와대 국민청원},
	pages = {1--28},
}

@article{yoo_childhood_teacher_petition_2021,
	title = {국민청원에 나타난 유아교사의 관심사 및 요구분석 : 2017.08 {\textasciitilde} 2021.06 기간의 게시글을 대상으로},
	volume = {25},
	issn = {1229-5809},
	shorttitle = {국민청원에 나타난 유아교사의 관심사 및 요구분석},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE10959265},
	doi = {10.32349/ECERR.2021.12.25.6.169},
	abstract = {본 연구는 유아교사가 사회참여의 일환으로써 공적으로 의제화한 국민청원 자료를 활용하여 그들의 요구 및 관심사를 알아보고자 수행되었다. 연구대상은 국민청원 게시판이 개설된 2017년 8월부터 2021년 6월까지 유아교사가 작성한 국민청원 게시글이다. 선별된 청원 게시글과 청원내용은 형식적 분석과 내용분석을 수행하였다. 연구결과 유아교사들은 인건비 및 복지 개선, 교사 대 유아 비율 감축 등 지속적인 요구를 제기하고 있었으며, 사립유치원의 비리와 코로나 19 등 각종 사회적 이슈에 따른 즉각적인 요구 역시 제기하고 있음을 확인할 수 있었다. 그러나 청와대의 답변을 받을 수 있는 기준인 청원 동의 인원 20만 명을 상회하는 게시글은 없었다. 본 연구는 유아교사의 요구와 관심사를 그들의 자발적인 언어로 확인하였다는 점, 유아교사의 사회참여 실제를 확인하였다는 점에서 의의가 있다.},
	language = {ko},
	number = {6},
	urldate = {2024-01-25},
	journal = {유아교육학논집},
	author = {유혜린 and 이정화},
	month = dec,
	year = {2021},
	keywords = {국민청원 (Korean national petition), 내용분석 (content analysis), 유아교사 (early childhood teacher)},
	pages = {169--193},
}

@article{yoon_assembly_petition_2020,
	title = {청원권의 실효적 보장을 위한 입법적 과제 - 국회 국민동의청원제도를 중심으로 -},
	volume = {17},
	issn = {1229-9251},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE10724133},
	abstract = {최근 입법, 행정 등 국정 전 분야에서 직접민주주의 또는 참여민주주의적 요소가 강화되는 제도적 변화가 전개되고 있다. 현재 대한민국 헌법 제26조에서 규정하고 있는 청원권이 불완전하나마 입법과정에 대한 국민의 참여를 보장하고 있다. 정부는 물론 대다수 국민들에게 잊혀진 권리였던 청원권은 문재인 정부가 2017년 개설한 청와대 국민청원에 의해 조명 받게 되었다. 그러나 청와대 국민청원의 문제점으로 권력집중 및 권력남용의 통로, 정치세력간 적대적 대결 공간으로의 변질 등이 지적되고 있다. 마침 국회는 2020년 1월부터 국민이 직접 온라인을 통해 법률 개정이나 제도 개선 등을 요청할 수 있는 국민동의청원시스템 운영을 시작했다. 국회법에 근거한 국민동의청원제도는 청원의 접수부터 처리까지 전 과정을 국회가 총괄하여 최종적인 입법으로까지 이어질 수 있기 때문에, 청와대 국민청원보다 청원인의 권리 실현에 직접적인 기여를 할 수 있다. 이에 국민동의청원제도는 ‘권리’로서의 청원의 성격을 보다 명확히 하고, 대의민주주의 시스템 안으로 직접민주주의적 요소를 통합했다는 긍정적 평가를 받고 있다21대 국회가 개원하고 첫 정기회를 앞둔 이 시점에서, 국회 국민동의청원제도가 국회와 국민과의 연결고리로서의 역할을 다할 수 있도록 국민들의 참여기회를 확대하고 정보소통을 원활히 하는 보완책들을 검토할 필요가 있다.},
	language = {ko},
	number = {2},
	urldate = {2024-01-25},
	journal = {입법학연구},
	author = {윤형석},
	month = jan,
	year = {2020},
	keywords = {국회 국민동의청원, 전자청원, 직접민주주의, 청와대 국민청원, 청원권},
	pages = {79--103},
}

