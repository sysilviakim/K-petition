	volume = {2},
	issn = {1771-8848},
	url = {https://www.cairn.info/revue-politique-americaine-2020-2-page-15.htm},
	abstract = {Le nombre d\&\#8217;\&\#233;lecteurs contribuant aux campagnes \&\#233;lectorales par de petits dons (\&\#171; small donors \&\#187; ou \&\#171; petits donateurs \&\#187;) conna\&\#238;t une nette augmentation ces derni\&\#232;res ann\&\#233;es. Cette tendance indique-t-elle une d\&\#233;mocratisation de la vie politique ? En effet, la mobilisation d\&\#8217;une plus large base de citoyens pourrait contrebalancer l\&\#8217;influence des plus riches et des entreprises injectant des sommes consid\&\#233;rables dans les partis politiques. Tr\&\#232;s peu de recherches nous renseignent quant aux effets d\&\#8217;un syst\&\#232;me de financement incitant les \&\#171; petits dons \&\#187; sur la vie politique de mani\&\#232;re plus large.Sur la base de donn\&\#233;es descriptives, cet article formule quelques hypoth\&\#232;ses dialoguant avec les th\&\#233;ories \&\#233;tablies sur le comportement politique des individus et des organisations. Notre argument principal insiste sur l\&\#8217;importance de relier les incitations aux petits dons avec le jeu des institutions et les dynamiques du syst\&\#232;me \&\#233;lectoral.Nos r\&\#233;sultats confirment que les petits donateurs sont plut\&\#244;t repr\&\#233;sentatifs du corps \&\#233;lectoral du point de vue de la proportion relative d\&\#8217;hommes et de femmes. Une r\&\#233;duction de l\&\#8217;\&\#233;cart en termes de repr\&\#233;sentativit\&\#233; des revenus est \&\#233;galement \&\#224; noter, bien que les petits donateurs aient des revenus sup\&\#233;rieurs au revenu m\&\#233;dian. Du point de vue id\&\#233;ologique, nous observons par ailleurs que les petits donateurs tiennent des positions plus radicales, et que par cons\&\#233;quent ils tendent \&\#224; offrir leurs contributions aux candidats se rapprochant des extr\&\#234;mes. Cette tendance se traduit par un renforcement de la polarisation \&\#224; diff\&\#233;rents niveaux de la vie politique (syst\&\#232;me partisan, recrutement des candidats, dynamique interne des partis, politiques publiques).},
	number = {35},
	urldate = {2021-08-08},
	journal = {Politique americaine},
	author = {Albert, Zachary and La Raja, Raymond},
	year = {2020},
	pages = {15--45},
}

