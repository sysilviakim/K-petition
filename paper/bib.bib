	author = {Cancela, João and Geys, Benny},
	month = jun,
	year = {2016},
	pages = {264--275},
}

@article{smets_embarrassment_2013,
	title = {The {Embarrassment} of {Riches}? {A} {Meta}-analysis of {Individual}-level {Research} on {Voter} {Turnout}},
	volume = {32},
	issn = {02613794},
	shorttitle = {The embarrassment of riches?},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0261379412001527},
	doi = {10.1016/j.electstud.2012.12.006},
	abstract = {Voter turnout has puzzled political scientists ever since Anthony Downs postulated the paradox of voting. Despite decades of research aiming to understand what drives citizens to the polls, the jury is still out on what the foundations of micro-level turnout are. This paper aims to provide a modest yet important contribution by taking a step back and summarizing where we stand and what we know. To this end, we review 90 empirical studies of individual level voter turnout in national elections published in ten top-journals during the past decade (2000–2010). Through a meta-analysis of the results reported in these studies, this paper identiﬁes those factors that are consistently linked to individual level turnout.},
	language = {en},
	number = {2},
	urldate = {2020-06-01},
	journal = {Electoral Studies},
	author = {Smets, Kaat and van Ham, Carolien},
	month = jun,
