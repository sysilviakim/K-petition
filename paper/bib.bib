@article{mulas-granados_automation_2019,
	title = {Automation, {Skills} and the {Future} of {Work}: {What} do {Workers} {Think}?},
	volume = {19},
	issn = {1018-5941},
	shorttitle = {Automation, {Skills} and the {Future} of {Work}},
	url = {https://elibrary.imf.org/openurl?genre=journal&issn=1018-5941&volume=2019&issue=288},
	doi = {10.5089/9781513519906.001},
	abstract = {We exploit a survey data set that contains information on how 11,000 workers across advanced and emerging market economies perceive the main forces shaping the future of work. In general, workers feel more positive than negative about automation, especially in emerging markets. We find that negative perceptions about automation are prevalent among workers who are older, poorer, more exposed to job volatility, and from countries with higher levels of robot penetration. Perceptions over automation are positively viewed by workers with higher levels of job satisfaction, higher educational attainment, and from countries with stronger labor protection. Workers with positive perceptions of automation also tend to respond that reeducation and retraining will be needed to adapt to rapidly evolving skill demands. These workers expect governments to have a role in shaping the future of work through protection of labor and new forms of social benefits. The demand for protection and benefits is more significant among women and workers that have suffered job volatility.},
	language = {en},
	number = {288},
	urldate = {2024-02-24},
	journal = {IMF Working Papers},
	author = {Mulas-Granados, Carlos and Varghese, Richard and Boranova, Vizhdan and deChalendar, Alice and Wallenstein, Judith},
	month = dec,
	year = {2019},
}

