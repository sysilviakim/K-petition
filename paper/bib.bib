	shorttitle = {The {Effect} of {Fact}-{Checking} on {Elites}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12162},
	doi = {10.1111/ajps.12162},
	abstract = {Does external monitoring improve democratic performance? Fact-checking has come to play an increasingly important role in political coverage in the United States, but some research suggests it may be ineffective at reducing public misperceptions about controversial issues. However, fact-checking might instead help improve political discourse by increasing the reputational costs or risks of spreading misinformation for political elites. To evaluate this deterrent hypothesis, we conducted a field experiment on a diverse group of state legislators from nine U.S. states in the months before the November 2012 election. In the experiment, a randomly assigned subset of state legislators was sent a series of letters about the risks to their reputation and electoral security if they were caught making questionable statements. The legislators who were sent these letters were substantially less likely to receive a negative fact-checking rating or to have their accuracy questioned publicly, suggesting that fact-checking can reduce inaccuracy when it poses a salient threat.},
	language = {en},
	number = {3},
	urldate = {2023-11-01},
	journal = {American Journal of Political Science},
	author = {Nyhan, Brendan and Reifler, Jason},
	year = {2015},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/ajps.12162},
	pages = {628--640},
}

@article{artes_compulsory_2023,
	title = {Compulsory civic duty and turnout: evidence from a natural experiment},
	issn = {2049-8470, 2049-8489},
	shorttitle = {Compulsory civic duty and turnout},
	url = {https://www.cambridge.org/core/journals/political-science-research-and-methods/article/compulsory-civic-duty-and-turnout-evidence-from-a-natural-experiment/A4513AB17F3E98BD251DD07F2552D7E0},
	doi = {10.1017/psrm.2023.44},
	abstract = {We study the effect of compulsory civic duty on turnout. We take advantage of a natural experiment in Spain, where electoral officers are selected through a lottery and being an electoral officer is compulsory for those drafted. We analyze whether acting as an officer changes turnout and attitudes in subsequent elections. Our findings show that compulsory civic duty has a strong short-term and positive effect on electoral participation, but has no impact on political attitudes. The positive effect of the civic duty treatment, however, fades after a few months. Our results have implications for theories about civic duty and the formation of political habits.},
	language = {en},
	urldate = {2023-11-01},
	journal = {Political Science Research and Methods},
	author = {Artes, Joaquin and Jurado, Ignacio},
	month = oct,
	year = {2023},
	note = {Publisher: Cambridge University Press},
	keywords = {Comparative politics: political behavior, experimental research, political participation and turnout},
	pages = {1--10},
}

