@article{mellon_opening_2018,
	title = {Opening the {Can} of {Worms}: {Most} {Existing} {Studies} of {Aggregate} {Level} {Turnout} are {Meaningless}},
	issn = {1556-5068},
	shorttitle = {Opening the {Can} of {Worms}},
	url = {https://www.ssrn.com/abstract=3098436},
	doi = {10.2139/ssrn.3098436},
	abstract = {We reveal the extent of errors in aggregate-level turnout measures in the US, UK and Sweden. In many cases, errors in measurement exceed substantive effects for institutional and event-based explanations of voter turnout. We find: 1) Errors in the vote numerator in the IDEA database sufficient to reverse the 1980-2016 trend in US VAP turnout; 2) VAP and VEP are increasingly diverging because of higher rates of non-eligible immigrants in all three countries; 3) errors in the registration denominator in the IDEA database large enough to create an erroneous 18 percentage point fall in US RV turnout between 2004 and 2008, and 4) underestimation of RV turnout due to inaccuracies in the voter register up to 11.5 percentage points in the UK and 20 percentage points in the US. In sum, claims about turnout using aggregate-level turnout measurement are likely to be highly misleading.},
	language = {en},
	urldate = {2020-06-02},
	journal = {SSRN Electronic Journal},
	author = {Mellon, Jonathan mname and Evans, Geoffrey mname and Fieldhouse, Edward A. mname and Green, Jane mname and Prosser, Christopher mname},
	year = {2018},
}

@article{bernstein_cross-state_2003,
	title = {Cross-{State} {Bias} in {Voting} and {Registration} {Overreporting} in the {Current} {Population} {Surveys}},
	volume = {3},
	issn = {1532-4400, 1946-1607},
	url = {http://journals.sagepub.com/doi/10.1177/153244000300300403},
	doi = {10.1177/153244000300300403},
	abstract = {There is tremendous nonrandom variation from state to state in the rates at which people overreport voting in the Current Population Surveys (CPS). What accounts for this state-level bias in overreporting? We ﬁnd that the determinants of statewide rates of overreporting parallel those in our earlier ﬁndings on individual-level overreporting: overreporting is a function of higher concentrations of racial and ethnic minorities, higher rates of religious membership, and being in the Deep South. These relationships are remarkably stable over time (1980–2000), and they are unaltered by improvements in how we measure overreporting. We suggest a method for deﬂating reported statewide registration ﬁgures to account for this bias, assuming that these registration ﬁgures are inﬂated in the same way as are statewide voting ﬁgures. We replicate and extend a part of Brown, Jackson, and Wright’s (1999) analysis using these deﬂated ﬁgures, showing that our approach can improve explanation.},
	language = {en},
	number = {4},
	urldate = {2020-06-02},
	journal = {State Politics \& Policy Quarterly},
	author = {Bernstein, Robert A. and Chadha, Anita and Montjoy, Robert},
	month = dec,
	year = {2003},
	pages = {367--386},
}

@article{gronke_convenience_2008,
	title = {Convenience {Voting}},
	volume = {11},
	issn = {1094-2939, 1545-1577},
	url = {http://www.annualreviews.org/doi/10.1146/annurev.polisci.11.053006.190912},
