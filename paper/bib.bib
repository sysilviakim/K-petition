@misc{shi_artificial_2020,
	title = {Artificial {Intelligence} for {Social} {Good}: {A} {Survey}},
	shorttitle = {Artificial {Intelligence} for {Social} {Good}},
	url = {http://arxiv.org/abs/2001.01818},
	doi = {10.48550/arXiv.2001.01818},
	abstract = {Artificial intelligence for social good (AI4SG) is a research theme that aims to use and advance artificial intelligence to address societal issues and improve the well-being of the world. AI4SG has received lots of attention from the research community in the past decade with several successful applications. Building on the most comprehensive collection of the AI4SG literature to date with over 1000 contributed papers, we provide a detailed account and analysis of the work under the theme in the following ways. (1) We quantitatively analyze the distribution and trend of the AI4SG literature in terms of application domains and AI techniques used. (2) We propose three conceptual methods to systematically group the existing literature and analyze the eight AI4SG application domains in a unified framework. (3) We distill five research topics that represent the common challenges in AI4SG across various application domains. (4) We discuss five issues that, we hope, can shed light on the future development of the AI4SG research.},
	urldate = {2024-02-07},
	publisher = {arXiv},
	author = {Shi, Zheyuan Ryan and Wang, Claire and Fang, Fei},
	month = jan,
	year = {2020},
	note = {arXiv:2001.01818 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computers and Society},
}

@article{__2023,
	title = {인공지능 거버넌스와 통상규범의 과제},
	volume = {21},
	issn = {2005-9949},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE11636374},
	doi = {10.46271/KJIEL.2023.11.21.3.105},
	abstract = {생성형 AI를 계기로 인공지능이 기술적 연구 차원을 넘어 글로벌 경제·사회의 혁명적 변화를 촉발할 기폭제로 주목받고 있다. 특히 제품 지능화, 생산공정 자율화, 새로운 혁신 가치 창출이 빠르게 진전되고, 데이터 경제와 디지털 교역이 새로운 세계화 시대를 열어가고 있다. 미국, EU, 중국 등 주요국은 미래 경제·군사 패권의 핵심이 될 AI 분야에서 전략적 우위를 점하기 위한 지정학 경쟁과 기술경쟁을 전개하는 중이다. 글로벌 통상의 주변환경과 패러다임이 격변하는 이 시기에 WTO 다자체제는 너무나도 뒤처져있다. 통상규범의 적실성이 의문시되는 어려운 시기일수록 국제사회가 처한 시대적 과제에 과감하게 뛰어들어 개방과 자유, 민주적 가치에 기초한 새로운 화두를 찾아 돌파구를 만들어야 한다. 본고는 AI 확산의 기술적, 경제적, 사회적 변화와 그 의미를 통상 측면에서 조망하고, AI 거버넌스를 둘러싼 글로벌 전략 경쟁과 기술 통상 협력을 지정학 시각에서 살펴보면서, 향후 통상규범이 우선적으로 다루어나갈 AI 통상의제로서 ① (법적규율) AI 제품·서비스 분류체계, ② (교역촉진) 표준 기반 상호운용, ③ (신뢰확보) AI 규제 적법성 기준, ④ (경제안보) 기술안보체제와의 조화를 제안하였다.},
	language = {ko},
	number = {3},
	urldate = {2024-02-01},
	journal = {국제경제법연구},
	author = {김호철},
	month = nov,
	year = {2023},
	keywords = {AI Transformation, AI regulations, AI 규제, Artificial Intelligence, Governance, Interoperability, Trade rules, 거버넌스, 상호운용, 인공지능, 지능형 혁신, 통상규범},
	pages = {105--133},
}

