@book{tran_unrigging_2018,
	title = {Unrigging {American} {Elections}: {Reform} {Past} and {Prologue}},
	isbn = {978-3-030-03547-1},
	shorttitle = {Unrigging {American} {Elections}},
	abstract = {This critical and systematic analysis of election reforms post-HAVA (Help America Vote Act of 2002) offers a detailed look ahead at the significant challenges that remain in the context of a new presidential administration. Employing a mixed methodological approach, this book analyzes the biggest election challenges faced by voters and election administrators in the areas of voter registration, polling place and non-polling place voting, election administration personnel, and voting technology. Within the framework of the competing values of integrity and access, this book fills a crucial gap in the existing literature by analyzing the impact of election reform wins and losses. The book concludes with a promising agenda for the future of election reform and the political considerations that will be brought to bear on that agenda.},
	language = {en},
