	url = {https://online.ucpress.edu/nrbp/article/1/4/452/114216/Black-Generational-Politics-and-the-Black-Lives},
	doi = {10.1525/nrbp.2020.1.4.452},
	abstract = {Despite its advocacy for justice and accountability in the American political system, the Movement for Black Lives is still considered controversial among groups of Americans. The in-your-face and unapologetic tone of today’s movement stands in contrast to romanticized narratives of the peaceful, nonviolent activism of the 1960s Civil Rights Movement. The movement’s titular organization, Black Lives Matter, openly rejects respectability politics—the notion that individuals and groups must conform to the expectations of white mainstream norms to protect themselves from the harms of white racism and discrimination. In this article, we examine whether generational politics affect Black attitudes toward protest movements, focusing especially on the Black Lives Matter organization. We expect that protest politics are affected by generations of Black Americans who have been socialized in different eras of social and political advocacy with differing views about the actions that are acceptable for Black politics. Consistent with prior literature, we anticipate that generational differences in attitudes toward contestation, varying awareness about the political and social goals of new movements, differences in access to political information, and overall generational socialization toward respectability politics will all affect the degree to which Black Americans support the Movement for Black Lives. Using national-level data from the 2016 Collaborative Multiracial Post-Election Survey (CMPS), we find that prior theories of generational politics do not fully explain support for Black Lives Matter. Unexpectedly, we find that older generations of Black Americans are more supportive of the movement than younger generations of Black Americans. We do not find strong evidence of generational effects interacting with awareness of the movement, political opportunity structures, or respectability politics, which suggests the diminishing effects of generational differences along with traditional factors that influence support. Our results underscore the need for research on generational effects to consider the context of political socialization, which varies across generations.},
	language = {en},
	number = {4},
	urldate = {2023-05-02},
	journal = {National Review of Black Politics},
	author = {Board, Marcus and Spry, Amber and Nunnally, Shayla C. and Sinclair-Chapman, Valeria},
	year = {2020},
	pages = {452--473},
}

@misc{spry_american_2018,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {American {Identity} and {Support} for the {Black} {Lives} {Matter} {Movement}},
	url = {https://papers.ssrn.com/abstract=3289761},
	abstract = {This paper examines the extent to which expressions of American identity amplify support for, or opposition to, the Black Lives Matter (BLM) movement. Existing research describes how the merits of protest activity are perceived differently across racial groups in the U.S. And, given the oft-different races between unarmed Black civilians and White police officers, the movement for equality in criminal justice has assumed racial overtones, with fissures between Blacks and Whites. While we may anticipate racial differences in support for the movement, we also ask, is black rights activism seen as a contradiction to, or a component of, one’s sense of “American identity”?  Using national public opinion data from the 2016 Collaborative Multiracial Post-Election Survey (N=10,144), we employ multivariate regression analysis to demonstrate that levels of support for BLM differ among White and Black respondents. Preliminary findings indicate that differences in support are even more pronounced when “American identity” is considered in the analysis. Among Whites, stronger expressions of “American Identity” are associated with stronger opposition to BLM. Blacks who indicate a strong American identity express even stronger support for BLM. Taken together, these findings provide context for understanding how “American identity” relates to support for protest activity and how the value of “American identity” can take on different meaning for different groups of Americans.},
	language = {en},
	urldate = {2023-05-02},
	author = {Spry, Amber and Nunnally, Shayla C.},
	year = {2018},
	keywords = {American politics, black politics, identity politics, protest, race and ethnic politics, social movements},
}

