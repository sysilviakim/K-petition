	keywords = {Biometric election technology, Civic education, Election audits, Election observation, Parallel vote tabulation, Social media},
	pages = {317--343},
}

@incollection{kropf_election_2020,
	series = {Elections, {Voting}, {Technology}},
	title = {Election {Costs}: {A} {Study} of {North} {Carolina}},
	isbn = {978-3-030-14947-5},
	shorttitle = {Election {Costs}},
	url = {https://doi.org/10.1007/978-3-030-14947-5_11},
	abstract = {Scholars, policymakers, and public interest groups interested in elections have much to learn about how much it costs to run elections. In terms of cost, there have been a number of important case studies and research about particular types of election inputs. However, there have been very few large-scale systematic attempts to learn about how much is spent on elections. In this chapter, we discuss the challenges inherent in collecting data concerning costs of election administration as well as efforts that different groups have made to collect these data more widely, and focus in particular on research on the 100 North Carolina counties. We find, for example, the more that is spent (per voter) on North Carolina election director salaries and spent on elections more generally, the higher the turnout. Counties that spend more on elections in North Carolina also have lower levels of residual votes. Despite recent data collection efforts and recent scholarship, it appears that there is still much to learn when it comes to the cost of elections, especially in the United States.},
	language = {en},
	urldate = {2020-11-28},
	booktitle = {The {Future} of {Election} {Administration}},
	publisher = {Palgrave-McMillan},
	author = {Kropf, Martha and Pope, JoEllen V.},
