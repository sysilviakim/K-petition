	note = {Conference Name: IEEE Engineering Management Review},
	keywords = {AI tools, Artificial Intelligence, Artificial intelligence, Chatbots, Companies, Employment, IEEE Regions, IEEE member, Surveys, Technological innovation, future impact, generative},
	pages = {1--6},
}

@article{blease_psychiatrists_2024,
	title = {Psychiatrists’ experiences and opinions of generative artificial intelligence in mental healthcare: {An} online mixed methods survey},
	volume = {333},
	issn = {0165-1781},
	shorttitle = {Psychiatrists’ experiences and opinions of generative artificial intelligence in mental healthcare},
	url = {https://www.sciencedirect.com/science/article/pii/S0165178124000118},
	doi = {10.1016/j.psychres.2024.115724},
	abstract = {Following the launch of ChatGPT in November 2022, interest in large language model (LLM)-powered chatbots has surged with increasing focus on the clinical potential of these tools. Missing from this discussion, however, are the perspectives of physicians. The current study aimed to explore psychiatrists’ experiences and opinions on this new generation of chatbots in mental health care. An online survey including both quantitative and qualitative responses was distributed to a non-probability sample of psychiatrists affiliated with the American Psychiatric Association. Findings revealed 44 \% of psychiatrists had used OpenAI's ChatGPT-3.5 and 33 \% had used GPT-4.0 “to assist with answering clinical questions.” Administrative tasks were cited as a major benefit of these tools: 70 \% somewhat agreed/agreed “documentation will be/is more efficient”. Three in four psychiatrists (75 \%) somewhat agreed/agreed “the majority of their patients will consult these tools before first seeing a doctor”. Nine in ten somewhat agreed/agreed that clinicians need more support/training in understanding these tools. Open-ended responses reflected these opinions but respondents also expressed divergent opinions on the value of generative AI in clinical practice, including its impact on the future of the profession.},
	urldate = {2024-02-01},
	journal = {Psychiatry Research},
	author = {Blease, Charlotte and Worthen, Abigail and Torous, John},
	month = mar,
	year = {2024},
	keywords = {Artificial intelligence, Chatbots, LLM, Psychiatry, Workforce},
	pages = {115724},
}

@inproceedings{nakazato_characterizing_2023,
	title = {Characterizing the {Behavior} of {Healthcare} {Experts} {Towards} {COVID}-19 {Vaccine} on {Twitter}},
	url = {https://ieeexplore.ieee.org/abstract/document/10350186?casa_token=m9QcWvL3m2kAAAAA:FhKpBzVDQG_yczm8DinxgwIzdDG_vXfhLW4LZKsx2P_QPxwNGYp7i4aHh-kObVNTruFEZFjWvanZ},
	doi = {10.1109/WI-IAT59888.2023.00100},
	abstract = {Spreading vaccine misinformation can have severe consequences for public health, including the increased risk of disease outbreaks. Even though experts with specialized knowl-edge can play a crucial role in combating vaccine misinformation, there is a lack of sufficient understanding on how healthcare experts communicated over social media during the early stages of the COVID-19 pandemic. Therefore, this study uses large-scale Twitter data in Japanese to examine how healthcare experts participated in key discussions about vaccines in 2020. Specifically, we identify healthcare expert users utilizing the Term Frequency - Inverse Document Frequency (TF-IDF) algorithm on social media profiles and analyze their distinctive behaviors in vaccine communication. Our findings indicate that healthcare experts were more likely to be pro-vaccine and less likely to be on the political right or neutral. We also find that these users received more replies and had more followers than the non-healthcare professional users, and that they tended to use different types of information sources compared to non-professionals. These findings highlight the unique position of healthcare professional users in the social media realm. Our study thus contributes to a better understanding of the role played by healthcare experts in public health policymaking, where social media has been increasing its presence.},
	urldate = {2024-02-01},
	booktitle = {2023 {IEEE}/{WIC} {International} {Conference} on {Web} {Intelligence} and {Intelligent} {Agent} {Technology} ({WI}-{IAT})},
	author = {Nakazato, Tomoka and Shibuya, Yuya and Takagi, Soichiro},
	month = oct,
	year = {2023},
	keywords = {Blogs, COVID-19, Healthcare Experts, Misinformation, Pandemics, Public Health, Science Communication, Social networking (online), Soft sensors, Vaccines, Video on demand},
	pages = {608--615},
}

