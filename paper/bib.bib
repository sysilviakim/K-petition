@article{arbour_tiny_2020,
	title = {Tiny {Donations}, {Big} {Impact}: {How} {Small}-{Dollar} {Donors} are {Eroding} the {Power} of {Party} {Insiders}},
	volume = {57},
	issn = {1936-4725},
	shorttitle = {Tiny {Donations}, {Big} {Impact}},
	url = {https://doi.org/10.1007/s12115-020-00520-4},
