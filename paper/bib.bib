	author = {Raze, Kyle},
	year = {2022},
	keywords = {Shelby County v. Holder, racial turnout gap, voter suppression, voting rights},
	pages = {1127--1141},
}

@article{cantoni_precinct_2020,
	title = {A {Precinct} {Too} {Far}: {Turnout} and {Voting} {Costs}},
	volume = {12},
	issn = {1945-7782},
	shorttitle = {A {Precinct} {Too} {Far}},
	url = {https://www.aeaweb.org/articles?id=10.1257/app.20180306},
	doi = {10.1257/app.20180306},
	abstract = {I study the effects of voting costs—specifically, distance to polling location—using geographic discontinuities. Opposite sides of boundaries between voting precincts are observationally identical, except for their assigned polling locations. This discontinuous assignment produces sharp changes in voters' travel distance to cast their ballots. In nine municipalities in Massachusetts and Minnesota, a 1 standard deviation (0.245 mile) increase in distance reduces ballots cast by 2 to 5 percent across four elections. During non-presidential elections, effects are three times larger in high-minority areas than in low-minority areas. Finally, I simulate the impact of various counterfactual assignments of voters to polling places.},
	language = {en},
	number = {1},
	urldate = {2023-07-18},
	journal = {American Economic Journal: Applied Economics},
	author = {Cantoni, Enrico},
	year = {2020},
	keywords = {Non-labor Discrimination, Transportation: Demand, Supply, and Congestion, Political Processes: Rent-seeking, Lobbying, Elections, Legislatures, and Voting Behavior, Economics of Minorities, Races, Indigenous Peoples, and Immigrants, Safety and Accidents, Transportation Noise, Travel Time},
	pages = {61--85},
}

@misc{morris_who_2020,
	title = {Who {Votes} {After} {Their} {Registration} is {Cancelled}? {Evidence} from {North} {Carolina}},
	shorttitle = {Who {Votes} {After} {Their} {Registration} is {Cancelled}?},
	url = {https://preprints.apsanet.org/engage/apsa/article-details/5f43c7e1b8a1230019967bf6},
	doi = {10.33774/apsa-2020-16mg1},
	abstract = {Voter list maintenance has received increasing attention in the press and from advocacy groups in the past few years. Little scholarly work, however, has detailed who is removed - or “purged” - despite no change in their legal eligibility to vote. By leveraging voter registration and provisional ballot data from North Carolina we identify individuals who were removed from the rolls between 2010 and 2016 despite no apparent change in their eligibility to vote and cast a provisional ballot in the 2016 presidential election. Although we find that minority voters were less likely than white voters to be removed overall, they were significantly more likely to cast a provisional ballot after being removed. Minorities who voted after being removed were also substantially less likely to have their provisional ballots counted than white voters. This paper presents the first evidence that imprecise voter list maintenance might disproportionately disenfranchise voters of color.},
	urldate = {2023-07-18},
	publisher = {APSA Preprints},
	author = {Morris, Kevin},
	month = aug,
	year = {2020},
}

