@article{mcgann_how_2002,
	title = {How an {Ideologically} {Concentrated} {Minority} {Can} {Trump} a {Dispersed} {Majority}: {Nonmedian} {Voter} {Results} for {Plurality}, {Run}-off, and {Sequential} {Elimination} {Elections}},
	volume = {46},
	issn = {0092-5853},
	shorttitle = {How an {Ideologically} {Concentrated} {Minority} {Can} {Trump} a {Dispersed} {Majority}},
	url = {https://www.jstor.org/stable/3088418},
	doi = {10.2307/3088418},
	abstract = {In contrast to Downs' (1957) median voter result for two-candidate elections, we should not expect multicandidate elections to produce outcomes around the median, even on average. Rather the winning candidate will tend to be between the median voter and the mode. This is true whether we consider plurality, run-off, or sequential elimination elections, and whether or not the electorate is divided into factions that control the nomination of candidates. For an unfactionalized electorate, computer simulation with randomly positioned candidates is used to model various electoral systems. This is because no equilibrium solution exists for this case. For a factionalized electorate, a game-theoretic model of faction formation is used. The results suggest that an ideologically cohesive minority around the mode of the population distribution may have a disproportionate influence on the outcome. These results can be applied to party leadership in the U.S. House, following Grofman, Koetzle, and McGann (forthcoming).},
	number = {1},
	urldate = {2023-01-17},
	journal = {American Journal of Political Science},
	author = {McGann, Anthony J. and Koetzle, William and Grofman, Bernard},
	year = {2002},
	pages = {134--147},
}

@article{johnston_limits_2019,
	title = {Limits and {Ironies} of {Transparency}: {Controlling} {Corruption} in {American} {Elections}},
	volume = {18},
	issn = {1533-1296},
	shorttitle = {Limits and {Ironies} of {Transparency}},
	url = {https://www.liebertpub.com/doi/full/10.1089/elj.2018.0530},
	doi = {10.1089/elj.2018.0530},
	abstract = {That transparency is a powerful check on corruption is an article of faith among many reformers, but in fact such benefits are elusive. Transparency can underwrite general accountability and political education and reveal some situational risks of corruption. But transparency policies miss much of what concerns many Americans about the influence of political money. Such policies are less likely to deter, or to spur effective responses to, outright corruption than we may assume. Moreover, transparency sometimes does more to help already-influential interests protect their advantages than to empower citizens. Finally, for transparency to check corruption, the data it reveals must be used in organized and focused ways, but collective action problems frequently intervene. Possible alternatives may be counterintuitive—for example, making campaign contributions anonymous and unverifiable. Ultimately it is difficult to show that transparency in campaign financing has restrained corruption, particularly if we consider the flows of funds it reveals in the context of the broader inequalities of politics and society.},
	number = {3},
	urldate = {2023-01-18},
	journal = {Election Law Journal: Rules, Politics, and Policy},
	author = {Johnston, Michael},
	year = {2019},
	keywords = {contributions, corruption, elections, reform, transparency},
	pages = {282--296},
}

@article{la_raja_sunshine_2007,
	title = {Sunshine {Laws} and the {Press}: {The} {Effect} of {Campaign} {Disclosure} on {News} {Reporting} in the {American} {States}},
	volume = {6},
	issn = {1533-1296},
	shorttitle = {Sunshine {Laws} and the {Press}},
	url = {http://www.liebertpub.com/doi/abs/10.1089/elj.2007.6302},
	doi = {10.1089/elj.2007.6302},
	abstract = {This study examines the relationship between the quality of campaign finance disclosure in the American states and print news coverage of campaign finance. Does better disclosure of money in politics have an effect on the quantity, content, and timing of news articles? The implications are important for the effectiveness of disclosure in informing voters about the role of money in politics and holding politicians accountable. In theory, better disclosure should decrease the cost of information, allowing journalists to write more articles in a timely manner and move beyond the typical horserace story about which candidate has more money. The findings provide strong evidence that better disclosure regimes tend to reduce horserace coverage but do not necessarily increase the number of articles that focus on potentially improper political contributions or expenditures. While there is a slight increase in the quantity of news articles about political money, there is no evidence that better disclosure improves timeliness of news reporting. A discussion follows about the implications of these findings for regulating money in politics, and proposes further research to evaluate the link between campaign finance transparency and political accountability.},
	number = {3},
	urldate = {2022-08-03},
	journal = {Election Law Journal: Rules, Politics, and Policy},
	author = {La Raja, Raymond J.},
	year = {2007},
	pages = {236--250},
}

@article{ansolabehere_scope_2007,
	title = {The {Scope} of {Corruption}: {Lessons} from {Comparative} {Campaign} {Finance} {Disclosure}},
	volume = {6},
	issn = {1533-1296},
	shorttitle = {The {Scope} of {Corruption}},
	url = {https://www.liebertpub.com/doi/abs/10.1089/elj.2007.6203},
	doi = {10.1089/elj.2007.6203},
	abstract = {This article describes two systems within which campaign finance laws seek to limit corruption. One consists of the legal and ethical rules governing relations between individual politicians and donors. The other is the macro-level regulation of total campaign spending and the acceptable level of private influence over the public sector. Disclosure is integral to both. Looking at four distinct systems, the U. S., the U. K., Germany, and California, I assess the scope of corruption at the micro (legal) and macro (regulatory) levels. To assess micro level evidence of corruption, I focus on the U.S. and California. These two systems have long experience with independent enforcement agencies. Both show evidence of effective and active enforcement of the laws, with violations of campaign finance laws on a very small scale. To assess the macro scale of corruption, I compare the growth of spending in all four systems. All four show an important regularity. Campaign spending is a very small fraction of national income (and of government spending) and it grows at the same rate of income. These facts are consistent with the view that corruption through campaign spending is a small societal problem. I conclude with a comment on why we should have disclosure, even though corruption in this system appears to be on a very small scale.},
	number = {2},
	urldate = {2023-01-18},
	journal = {Election Law Journal: Rules, Politics, and Policy},
	author = {Ansolabehere, Stephen},
	year = {2007},
	pages = {163--183},
}

