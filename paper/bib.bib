@article{graham-squire_examination_2023,
	title = {An {Examination} of {Ranked}-{Choice} {Voting} in the {United} {States}, 2004–2022},
	volume = {0},
	issn = {0034-4893},
	url = {https://doi.org/10.1080/00344893.2023.2221689},
	doi = {10.1080/00344893.2023.2221689},
	abstract = {From the perspective of social choice theory, ranked-choice voting (RCV) is known to have many flaws. RCV can fail to elect a Condorcet winner and is susceptible to monotonicity paradoxes and the spoiler effect, for example. We use a database of 185 American ranked-choice elections for political office from the years 2004 to 2022 to investigate empirically how frequently RCV’s deficiencies manifest in practice. Our general finding is that RCV’s weaknesses are rarely observed in real-world elections, with the exception that ballot exhaustion frequently causes majoritarian failures.},
	number = {0},
	urldate = {2023-07-09},
	journal = {Representation},
	author = {Graham-Squire, Adam and McCune, David},
	month = jun,
	year = {2023},
	note = {Publisher: Routledge
\_eprint: https://doi.org/10.1080/00344893.2023.2221689},
	keywords = {Condorcet winner, Ranked-choice voting, ballot exhaustion, empirical results, monotonicity paradox},
	pages = {1--19},
}

