@article{lee_ai_inequality_2021,
	title = {인공지능과 미래의 불평등, 그리고 민주주의},
	volume = {39},
	issn = {1598-5946},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE11306586},
	abstract = {본 논문은 인공지능에 의한 인간의 일자리 대체 확대가 고용구조와 계층구조에 어떤 변화를 초래하고, 그것이 민주주의에 미치는 정치적 하중을 분석한다. 특히 시민이 인공지능에 의해 수동적 객체로 전락하는 점과 함께 인공지능에 의한 실업의 증가와 부의 양극화현상이 민주주의의 위기와 어떤 관련성이 있는지의 문제를 분석한다. 분석 결과 인공지능에 의한 실업의 증가는 사회 구성원 간 부의 불평등 심화와 초양극화사회를 초래하는 동시에 정치적 평등이라는 민주주의의 핵심 가치를 부정함을 확인할 수있었다. 특히 플랫폼을 지배하는 극히 일부가 경제적 부를 독점하고, 이들이 관리하고 통제하는 인공지능 알고리즘이 의사결정 과정을 지배하게 된다. 이에 민주주의는 시민 주권의 약화, 대표성의 형해화, 그리고 시민의 정치참여 배제 등과 같은 심각한 변화에 직면하게 될 것으로 보인다.},
	language = {ko},
	number = {4},
	urldate = {2024-02-15},
	journal = {세계지역연구논총},
	author = {이기완},
	month = dec,
	year = {2021},
	pages = {1--23},
}

