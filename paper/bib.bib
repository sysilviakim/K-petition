@article{__2020,
	title = {유권자의 정치 관심은 언제나 바람직한가? : 정부 신뢰의 이념 편향을 중심으로},
	volume = {54},
	issn = {1229-506X},
	shorttitle = {유권자의 정치 관심은 언제나 바람직한가?},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE09361945},
	doi = {10.18854/kpsr.2020.54.2.002},
	abstract = {정치에 관심을 갖는 유권자들은 정치 과정에 적극적으로 참여함으로써, 정부의 책임성과 반응성을 제고하는 역할을 한다. 이에 많은 연구들은 유권자의 정치 관심을 증진시키는 방안으로 시민교육의 중요성을 강조해 왔다. 기존 연구들은 정치 관심이 가지는 규범적으로 바람직하며 긍정적인 속성에 초점을 맞추어 왔던 것이다. 기존 연구와 달리 이 연구는 정치 관심이 갖는 부작용을 검토한다. 구체적으로 본 연구는 정치 관심이 높은 유권자들에게서 더욱 강한 이념 편향성이 나타난다는 것을 경험적으로 검증하고 있다. 설문 자료 분석 결과, 보수 정당이 집권한 2014년에는 보수적인 유권자가 정부를 보다 신뢰하는 반면, 진보 정당이 집권한 2018년에는 진보적인 유권자가 정부에 대해 높은 신뢰를 보냄을 확인할 수 있었다. 그런데 이 경향성이 정치 관심이 높은 유권자에게서 더 강하게 나타난다는 결과가 본 연구의 핵심적인 발견이다. 이 연구는 이념적으로 양극화된 정치적 환경하에서 바람직한 대의민주주의의 실현을 위해서는 정치 관심의 고취에 그치는 것이 아닌, 합리적 유권자의 육성이 필요함을 시사한다.},
	language = {ko},
	number = {2},
	urldate = {2024-02-19},
	journal = {한국정치학회보},
	author = {하상응 and 길정아},
	month = jun,
	year = {2020},
	pages = {31--57},
}

@article{__2021,
	title = {정당과 정당원의 주관적 이념 불일치의 원인과 결과에 대한 경험적 연구},
	volume = {11},
	issn = {2233-7148},
	url = {https://www.dbpia.co.kr/Journal/articleDetail?nodeId=NODE10573752},
	abstract = {본 연구는 정당원이 소속 정당에 느끼는 주관적 이념 불일치의 요인과 그 정치적 결과에 대해서 경험적 분석을 시도한다. 2020년 총선 후 실시된 정당원 설문조사를 분석한 결과, 남성이 여성보다, 정치적 효능감이 낮을수록, 정치적 관심도가 높을수록, 당원이 소속 정당에 느끼는 이념적 동질성 정도는 낮아지는 것으로 나타났다. 그러나 당원의 정치적 지식이나 정당 내 역할, 정당 활동 기간과 다른 사회경제적 조건은 당원과 소속 정당의 이념적 동질성 정도에 유의미한 영향을 미치지 않는 것으로 나타났다. 한편, 당원이 소속 정당에 이념적 불일치를 강하게 느낄수록, 정당이탈 의향, 정당배반 투표 확률이 높아졌으며, 정당 지도부의 리더쉽에 불만을 가질 확률이 높아지는 것으로 나타났다. 본 연구는 한국의 정당원들을 대상으로는 처음으로 정당원들과 소속 정당의 이념적 불일치의 요인과 그로 인한 정당원들의 행태를 분석하였다는 점에서 한국 정당 연구에 중요한 기여를 하였다고 생각한다.},
	language = {ko},
	number = {1},
	urldate = {2024-02-19},
	journal = {미래정치연구},
	author = {신정섭},
	month = jun,
	year = {2021},
	pages = {83--114},
}

@article{ma_are_2023,
	title = {Are users willing to embrace {ChatGPT}? {Exploring} the factors on the acceptance of chatbots from the perspective of {AIDUA} framework},
	volume = {75},
	issn = {0160-791X},
	shorttitle = {Are users willing to embrace {ChatGPT}?},
	url = {https://www.sciencedirect.com/science/article/pii/S0160791X23001677},
	doi = {10.1016/j.techsoc.2023.102362},
	abstract = {As a rapidly emerging generative AI chatbot, ChatGPT has garnered unprecedented global attention for its advanced AI-based text generation capabilities. However, the issue of ChatGPT acceptance requires further investigation. Prior studies on chatbot acceptance primarily focused on traditional technology acceptance models (TAMs) and did not consider the intelligence features of AI technology. Based on the AI device use acceptance (AIDUA) model and cognitive appraisal theory (CAT), this study proposed a research model to investigate the acceptance of ChatGPT. Participants with experience using ChatGPT were invited to take part in the survey. A total of 500 valid questionnaires were collected through the Credamo survey platform. Our findings reveal compelling associations: social influence, novelty value, and humanness positively correlate with performance expectations, while hedonic motivation, novelty value, and humanness negatively correlate with effort expectations. Both performance and effort expectations contribute to cognitive attitudes. Age, as a control variable, exhibits a significant negative impact on the willingness to reject ChatGPT. Notably, this study expands the current AIDUA framework within chatbot contexts by incorporating perspectives on novelty value, perceived humanness, and cognitive attitudes to examine chatbot acceptance. These insights offer practical implications for the design and development of AI-based chatbots, contributing to the evolving landscape of AI technology acceptance.},
	urldate = {2024-02-19},
	journal = {Technology in Society},
	author = {Ma, Xiaoyue and Huo, Yudi},
	month = nov,
	year = {2023},
	keywords = {AIDUA, Chatbot, Cognitive appraisal theory, Novelty value, Perceived humanness},
	pages = {102362},
}

