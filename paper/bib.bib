	year = {2022},
	note = {tex.ids= coll\_proper\_2022-1
publisher: SAGE Publications Inc},
	keywords = {COVID-19, survey of the performance of American elections, voter experiences, voter perceptions, voter safety},
	pages = {1532673X221112396},
}

@article{mccarthy_ranked_2021,
	title = {Ranked {Choice} {Voting} as a {Generational} {Issue} in {Modern} {American} {Politics}},
	volume = {49},
	issn = {1747-1346},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/polp.12390},
	doi = {10.1111/polp.12390},
	abstract = {Ranked Choice Voting (RCV) is a class of reforms increasingly used in the United States to replace plurality and runoff elections. We ask whether support for RCV taps a larger generational divide in politics. We consult five surveys, two of these from recent adoption campaigns, and all with different ways of asking about RCV support. Generation is a significant predictor in four of these samples, accounting for standard demographic factors and partisanship. This relationship also holds within black and Republican subgroups, two groups often thought to be less likely to support RCV. Finally, we find that dissatisfaction with “the way that democracy works in America” is a plausible link between generation and reform support. For better or worse, RCV has potential to divide two important voting blocs in America. Our results suggest that, rather than turn away from electoral politics, a disaffected young generation may turn to reform. Related Articles Cormack, Lindsey. 2019. “Leveraging Peer-to-Peer Connections to Increase Voter Participation in Local Elections.” Politics \& Policy 47 (2): 248-266. https://doi.org/10.1111/polp.12297 Fisher, Patrick. 2020. “Generational Replacement and the Impending Transformation of the American Electorate.” Politics \& Policy 48 (1): 38-68. https://doi.org/10.1111/polp.12340 Shaykhutdinov, Renat. 2019. “Socialization, Rationality, and Age: Generational Gaps and the Attitudes toward the Chechen War in Russia.” Politics \& Policy 47 (5): 931-955. https://doi.org/10.1111/polp.12323},
	language = {en},
	number = {1},
	urldate = {2021-11-16},
	journal = {Politics \& Policy},
	author = {McCarthy, Devin and Santucci, Jack},
	year = {2021},
	keywords = {Alternative Vote, Democratic Discontent, Electoral Reform, Generational Conflict, Political Satisfaction, Preferential Voting, Public Opinion, RCV, Ranked Choice Voting, Satisfaction in American Democracy, United States},
	pages = {33--60},
}

